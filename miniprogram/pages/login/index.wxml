<view class="login-container">
  <view class="logo">
    <text class="logo-text">业主投票评价系统</text>
  </view>
  
  <view class="login-options">
    <button class="login-btn wechat-btn" open-type="getPhoneNumber" bindgetphonenumber="onWechatLogin">
      <image src="/images/wechat-icon.png" class="btn-icon"></image>
      微信登录
    </button>
    <!-- 临时测试按钮：点击触发 mock wechatLogin
    <button class="login-btn debug-btn" bindtap="testWechatLogin">测试 wechatLogin (pending)</button> -->
    
    <view class="guest-login" bindtap="onGuestLogin">游客登录</view>
  </view>
  
  <view class="agreement">
    <label class="agreement-checkbox">
      <checkbox checked="{{agreed}}" bindtap="toggleAgreement" />
      <text class="agreement-text">我已阅读并同意</text>
    </label>
    <text class="agreement-link" bindtap="showServiceAgreement">《服务协议》</text>
    <text class="agreement-text">和</text>
    <text class="agreement-link" bindtap="showPrivacyPolicy">《隐私政策》</text>
  </view>
</view>
.evaluation-container {
  padding: 30rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

.guest-mode-tip {
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #ad6800;
}

.score-option.disabled {
  opacity: 0.75;
}

/* 选项卡样式 */
.tab-container {
  display: flex;
  background: white;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s;
  font-weight: 500;
}

.tab-item.active {
  background: linear-gradient(135deg, #1aad19, #4cd964);
  color: white;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(26, 173, 25, 0.3);
}

.content-section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: #333;
  text-align: center;
}

.page-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  position: relative;
}

.back-btn {
  font-size: 28rpx;
  color: #1aad19;
  padding: 10rpx 0;
}

.page-title-small {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-right: 80rpx; /* 抵消返回按钮的宽度，保持标题居中 */
}

/* 评价周期列表 */
.cycles-list {
  margin: 20rpx 0;
}

.cycle-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.3s;
}

.cycle-item:active {
  background: #f0f0f0;
  transform: scale(0.98);
}

.cycle-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.cycle-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  padding-right: 20rpx;
}

.cycle-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.cycle-tag.ongoing {
  background: #e6f7e6;
  color: #1aad19;
}

.cycle-tag.completed {
  background: #f0f0f0;
  color: #999;
}

.cycle-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cycle-time {
  font-size: 24rpx;
  color: #666;
}

.cycle-progress {
  font-size: 24rpx;
  color: #999;
}

/* 人员选择弹窗 */
.staff-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 85%;
  max-height: 70%;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 0 10rpx;
}

.staff-list {
  max-height: 800rpx;
  padding: 20rpx;
}

.staff-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.staff-item.disabled {
  opacity: 0.5;
}

.staff-photo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #e0e0e0;
}

.staff-photo.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1aad19, #4cd964);
  color: white;
  font-size: 36rpx;
  font-weight: bold;
}

.staff-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.staff-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.staff-position {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.staff-workscope {
  font-size: 24rpx;
  color: #666;
  background: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
  margin-top: 8rpx;
}

.staff-status {
  font-size: 26rpx;
}

.staff-status .evaluated {
  color: #999;
}

.staff-status .arrow {
  color: #1aad19;
  font-size: 32rpx;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.evaluation-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.info-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #e0e0e0, transparent);
  margin: 32rpx 0;
}

/* 选择服务人员区域 */
.select-staff-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx dashed #e0e0e0;
  margin-bottom: 24rpx;
  transition: all 0.3s;
}

.select-staff-section:active {
  background: #f0f0f0;
}

.select-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.select-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.selected-staff {
  font-size: 26rpx;
  color: #1aad19;
  font-weight: 500;
}

.placeholder {
  font-size: 26rpx;
  color: #999;
}

.select-arrow {
  font-size: 28rpx;
  color: #999;
  font-weight: bold;
  margin-left: 20rpx;
}

/* 评价内容区域 */
.evaluation-content {
  margin-top: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-note {
  font-size: 24rpx;
  color: #999;
}

/* 评分区块样式 */
.score-section {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e8e8e8;
}

.property-score-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e8e8e8;
}

.score-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.score-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.current-score {
  font-size: 28rpx;
  color: #1aad19;
  font-weight: bold;
  width: 120rpx;
  text-align: right;
}

/* 评分选择器样式 */
.score-selector {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.score-option {
  flex: 1;
  height: 50rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  background: white;
  transition: all 0.3s;
  min-width: 0;
  line-height: 80rpx; /* 关键：设置行高等于容器高度 */
  text-align: center;
}

.score-option:active {
  transform: scale(0.95);
}

.score-option.selected {
  background: #1aad19;
  color: white;
  border-color: #1aad19;
  transform: scale(1.05);
  box-shadow: 0 4rpx 12rpx rgba(26, 173, 25, 0.3);
  line-height: 80rpx; /* 选中状态也要设置 */
}

/* 物业公司评分特殊样式 */
.property-scores {
  margin-bottom: 20rpx;
}

.property-score-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e8e8e8;
}

.property-score-item .score-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.property-score-item .score-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.property-score-item .current-score {
  font-size: 28rpx;
  color: #1aad19;
  font-weight: bold;
  width: 120rpx;
  text-align: right;
}

/* 物业公司评分特殊样式 */
.property-scores {
  margin-bottom: 20rpx;
}

.property-score-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e8e8e8;
}

.property-score-item .score-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.property-score-item .score-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.property-score-item .current-score {
  font-size: 28rpx;
  color: #1aad19;
  font-weight: bold;
  width: 120rpx;
  text-align: right;
}

/* 物业公司评分选择器 - 调整为10个选项 */
.property-score-item .score-selector {
  display: flex;
  justify-content: space-between;
  gap: 8rpx; /* 减少间距以适应10个选项 */
}

.property-score-item .score-option {
  flex: 1;
  height: 50rpx; /* 减小高度以适应10个选项 */
  border: 2rpx solid #e0e0e0;
  border-radius: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  transition: all 0.3s;
  min-width: 0;
}

.property-score-item .score-text {
  font-size: 24rpx; /* 减小字体大小 */
  color: #666;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.property-score-item .score-option:active {
  transform: scale(0.95);
}

.property-score-item .score-option.selected {
  background: #1aad19;
  border-color: #1aad19;
  transform: scale(1.05);
  box-shadow: 0 4rpx 12rpx rgba(26, 173, 25, 0.3);
}

.property-score-item .score-option.selected .score-text {
  color: white;
  font-weight: bold;
}
/* 评价规则 */
.evaluation-rules {
  background: #fff8e8;
  border: 1rpx solid #ffd56a;
  border-radius: 12rpx;
  padding: 28rpx;
  margin: 32rpx 0;
}

.rules-title {
  font-size: 26rpx;
  color: #e6a23c;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.rule-item {
  font-size: 24rpx;
  color: #e6a23c;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

/* 留言板 */
.comment-section {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e8e8e8;
}

.comment-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.comment-input {
  width: 100%;
  min-height: 180rpx;
  background: white;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid #e0e0e0;
  box-sizing: border-box;
}

.comment-count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.comment-content {
  background: white;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid #e0e0e0;
  line-height: 1.6;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.comment-empty {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

.warning-note {
  font-size: 24rpx;
  color: #ff6b6b;
  text-align: center;
  display: block;
  margin: 40rpx 0;
  line-height: 1.6;
  padding: 0 20rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #1aad19, #4cd964);
  color: white;
  border: none;
  border-radius: 16rpx;
  padding: 14rpx;
  font-size: 32rpx;
  font-weight: bold;
  width: 100%;
  box-shadow: 0 8rpx 24rpx rgba(26, 173, 25, 0.3);
  transition: all 0.3s;
  margin-top: 20rpx;
}

.submit-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(26, 173, 25, 0.3);
}

.submit-btn:disabled {
  background: #ccc;
  box-shadow: none;
  transform: none;
}

/* 评价历史列表 */
.history-list {
  padding: 20rpx;
}

.history-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.history-time {
  font-size: 24rpx;
  color: #999;
}

.history-staff-info {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
}

.staff-photo-small {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
}

.staff-photo-small.placeholder {
  background: linear-gradient(135deg, #1aad19 0%, #4cd964 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 36rpx;
  font-weight: bold;
}

.staff-detail {
  display: flex;
  flex-direction: column;
}

.staff-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.staff-position {
  font-size: 26rpx;
  color: #999;
}

.divider-small {
  height: 1rpx;
  background: #f0f0f0;
  margin: 20rpx 0;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 只读模式样式 */
.score-selector.readonly .score-option {
  pointer-events: none;
  opacity: 0.8;
}

.score-selector.readonly .score-option.selected {
  background: #d0e8d0;
  border-color: #52c41a;
}

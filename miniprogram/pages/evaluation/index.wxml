<view class="evaluation-container">
  <!-- 顶部选项卡 -->
  <view class="tab-container">
    <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">
      服务人员
    </view>
    <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">
      物业公司
    </view>
  </view>

  <!-- 服务人员评价 -->
  <view class="content-section" wx:if="{{currentTab === 0}}">
    <!-- 评价周期列表 -->
    <view wx:if="{{!currentCycle}}">
      <view class="page-title">选择评价活动</view>
      
      <view class="cycles-list">
        <view 
          class="cycle-item" 
          wx:for="{{cycles}}" 
          wx:key="_id"
          bindtap="selectCycle"
          data-index="{{index}}"
        >
          <view class="cycle-header">
            <text class="cycle-title">{{item.title}}</text>
            <view class="cycle-tag {{item.hasEvaluated ? 'completed' : 'ongoing'}}">
              {{item.hasEvaluated ? '已完成' : '进行中'}}
            </view>
          </view>
          <view class="cycle-info">
            <text class="cycle-time">截止时间：{{item.deadline}}</text>
            <text class="cycle-progress">已评价 {{item.evaluatedCount || 0}}/{{item.totalStaffCount || 0}} 人</text>
          </view>
        </view>
        
        <view class="empty-tip" wx:if="{{cycles.length === 0}}">
          <text>暂无进行中的评价活动</text>
        </view>
      </view>
    </view>

    <!-- 评价详情页 -->
    <view wx:else>
      <view class="page-header">
        <text class="back-btn" bindtap="backToCyclesList">← 返回</text>
        <text class="page-title-small">{{isViewMode ? '评价历史' : '选择服务人员'}}</text>
      </view>

      <view class="evaluation-info">
        <text class="info-item">评价周期：{{currentCycle.startDate}} 至 {{currentCycle.endDate}}</text>
        <text class="info-item">评价截止时间：{{currentCycle.deadline}}</text>
      </view>

      <view class="divider"></view>

      <!-- 评价历史列表 -->
      <view wx:if="{{isViewMode}}" class="history-list">
        <view class="history-item" wx:for="{{evaluationHistory}}" wx:for-item="evaluation" wx:key="_id">
          <view class="history-staff-info">
            <image class="staff-photo-small" src="{{evaluation.staff.photo}}" mode="aspectFill" wx:if="{{evaluation.staff.photo}}" />
            <view class="staff-photo-small placeholder" wx:else>
              <text>{{evaluation.staff.name.substring(0, 1)}}</text>
            </view>
            <view class="staff-detail">
              <text class="staff-name">{{evaluation.staff.name}}</text>
              <text class="staff-position">{{evaluation.staff.position}}</text>
            </view>
          </view>

          <view class="divider-small"></view>

          <!-- 评分详情 -->
          <view class="score-section" wx:for="{{dimensions}}" wx:for-item="dimension" wx:key="name">
            <view class="score-header">
              <text class="score-label">{{dimension.name}}：</text>
              <text class="current-score">{{evaluation.scores[dimension.name] || 0}} 分</text>
            </view>
            <view class="score-selector readonly">
              <view wx:for="{{10}}" wx:for-item="scoreNum" wx:key="index" 
                class="score-option {{index < evaluation.scores[dimension.name] ? 'selected' : ''}}">
                <text class="score-text">{{index + 1}}</text>
              </view>
            </view>
          </view>

          <!-- 留言板 -->
          <view class="comment-section" wx:if="{{evaluation.comment}}">
            <view class="comment-label">留言内容</view>
            <view class="comment-content">{{evaluation.comment}}</view>
          </view>
          <view class="comment-section" wx:else>
            <view class="comment-label">留言内容</view>
            <view class="comment-empty">未留言</view>
          </view>
        </view>

        <view class="empty-tip" wx:if="{{evaluationHistory.length === 0}}">
          <text>暂无评价记录</text>
        </view>
      </view>

      <!-- 选择服务人员区域 -->
      <view wx:else class="select-staff-section" bindtap="openStaffSelector">
      <view class="select-left">
        <text class="select-label">选择服务人员</text>
        <text class="selected-staff" wx:if="{{selectedStaff}}">{{selectedStaff.name}} - {{selectedStaff.position}}</text>
        <text class="placeholder" wx:else>请选择要评价的服务人员</text>
      </view>
      <text class="select-arrow">></text>
    </view>

    <view class="divider" wx:if="{{selectedStaff}}"></view>

    <!-- 评价内容 -->
    <view class="evaluation-content" wx:if="{{selectedStaff}}">
      <view class="section-header">
        <text class="section-title">评价内容</text>
        <text class="section-note">注：满分为10分</text>
      </view>
      
      <!-- 动态评价维度 -->
      <view class="score-section" wx:for="{{dimensions}}" wx:for-item="dimension" wx:key="name">
        <view class="score-header">
          <text class="score-label">{{dimension.name}}：</text>
          <text class="current-score">{{scores[dimension.name] || 0}} 分</text>
        </view>
        <view class="score-selector">
          <view wx:for="{{10}}" wx:for-item="scoreNum" wx:key="index" 
            class="score-option {{index < scores[dimension.name] ? 'selected' : ''}}"
            bindtap="setScore"
            data-dimension="{{dimension.name}}"
            data-score="{{index + 1}}">
            <text class="score-text">{{index + 1}}</text>
          </view>
        </view>
      </view>

      <!-- 留言板 -->
      <view class="comment-section">
        <view class="comment-label">留言板（选填）</view>
        <textarea 
          class="comment-input" 
          placeholder="请输入您的意见或建议"
          maxlength="500"
          value="{{comment}}"
          bindinput="onCommentInput"
        />
        <view class="comment-count">{{comment ? comment.length : 0}}/500</view>
      </view>

      <text class="warning-note">注：您的评价将影响到员工的工资、奖金等等，请理性、客观评价</text>

      <button class="submit-btn" bindtap="submitEvaluation" disabled="{{loading}}">
        {{loading ? '提交中...' : '提交评价'}}
      </button>
    </view>
    </view>
  </view>

  <!-- 物业公司评价 -->
  <view class="content-section" wx:if="{{currentTab === 1}}">
    <!-- 评价周期列表 -->
    <view wx:if="{{!currentCycle}}">
      <view class="page-title">选择评价活动</view>
      
      <view class="cycles-list">
        <view 
          class="cycle-item" 
          wx:for="{{cycles}}" 
          wx:key="_id"
          bindtap="selectCycle"
          data-index="{{index}}"
        >
          <view class="cycle-header">
            <text class="cycle-title">{{item.title}}</text>
            <view class="cycle-tag {{item.hasEvaluated ? 'completed' : 'ongoing'}}">
              {{item.hasEvaluated ? '已完成' : '进行中'}}
            </view>
          </view>
          <view class="cycle-info">
            <text class="cycle-time">截止时间：{{item.deadline}}</text>
          </view>
        </view>
        
        <view class="empty-tip" wx:if="{{cycles.length === 0}}">
          <text>暂无进行中的评价活动</text>
        </view>
      </view>
    </view>

    <!-- 评价详情页 -->
    <view wx:else>
      <view class="page-header">
        <text class="back-btn" bindtap="backToCyclesList">← 返回</text>
        <text class="page-title-small">{{isViewMode ? '评价历史' : '物业公司评价'}}</text>
      </view>

      <view class="evaluation-info">
        <text class="info-item">评价周期：{{currentCycle.startDate}} 至 {{currentCycle.endDate}}</text>
        <text class="info-item">评价截止时间：{{currentCycle.deadline}}</text>
      </view>

      <view class="divider"></view>

      <!-- 评价历史 -->
      <view wx:if="{{isViewMode}}" class="history-list">
        <view class="history-item" wx:for="{{evaluationHistory}}" wx:for-item="evaluation" wx:key="_id">
          <view class="history-header">
            <text class="history-title">我的评价</text>
            <text class="history-time" wx:if="{{evaluation.createdAt}}">{{evaluation.createdAt}}</text>
          </view>

          <view class="divider-small"></view>

          <!-- 评分详情 -->
          <view class="score-section" wx:for="{{dimensions}}" wx:for-item="dimension" wx:key="name">
            <view class="score-header">
              <text class="score-label">{{dimension.name}}：</text>
              <text class="current-score">{{evaluation.scores[dimension.name] || 0}} 分</text>
            </view>
            <view class="score-selector readonly">
              <view wx:for="{{10}}" wx:for-item="scoreNum" wx:key="index" 
                class="score-option {{index < evaluation.scores[dimension.name] ? 'selected' : ''}}">
                <text class="score-text">{{index + 1}}</text>
              </view>
            </view>
          </view>

          <!-- 留言板 -->
          <view class="comment-section" wx:if="{{evaluation.comment}}">
            <view class="comment-label">留言内容</view>
            <view class="comment-content">{{evaluation.comment}}</view>
          </view>
          <view class="comment-section" wx:else>
            <view class="comment-label">留言内容</view>
            <view class="comment-empty">未留言</view>
          </view>
        </view>

        <view class="empty-tip" wx:if="{{evaluationHistory.length === 0}}">
          <text>暂无评价记录</text>
        </view>
      </view>

      <!-- 评价内容 -->
      <view class="evaluation-content" wx:else>
        <view class="section-header">
          <text class="section-title">评价内容</text>
          <text class="section-note">注：满分为10分</text>
        </view>
        
        <!-- 动态评价维度 -->
        <view class="score-section" wx:for="{{dimensions}}" wx:for-item="dimension" wx:key="name">
          <view class="score-header">
            <text class="score-label">{{dimension.name}}：</text>
            <text class="current-score">{{scores[dimension.name] || 0}} 分</text>
          </view>
          <view class="score-selector">
            <view wx:for="{{10}}" wx:for-item="scoreNum" wx:key="index" 
              class="score-option {{index < scores[dimension.name] ? 'selected' : ''}}"
              bindtap="setScore"
              data-dimension="{{dimension.name}}"
              data-score="{{index + 1}}">
              <text class="score-text">{{index + 1}}</text>
            </view>
          </view>
        </view>

        <!-- 留言板 -->
        <view class="comment-section">
          <view class="comment-label">留言板（选填）</view>
          <textarea 
            class="comment-input" 
            placeholder="请输入您的意见或建议"
            maxlength="500"
            value="{{comment}}"
            bindinput="onCommentInput"
          />
          <view class="comment-count">{{comment ? comment.length : 0}}/500</view>
        </view>

        <text class="warning-note">注：您的评价将影响到物业公司的服务质量改进，请理性、客观评价</text>

        <button class="submit-btn" bindtap="submitEvaluation" disabled="{{loading}}">
          {{loading ? '提交中...' : '提交评价'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 选择人员弹窗 -->
  <view class="staff-modal" wx:if="{{showStaffModal}}" catchtap="closeStaffModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">选择服务人员</text>
        <text class="modal-close" bindtap="closeStaffModal">✕</text>
      </view>
      <scroll-view class="staff-list" scroll-y>
        <view 
          class="staff-item {{item.hasEvaluated ? 'disabled' : ''}}" 
          wx:for="{{staffList}}" 
          wx:key="_id"
          bindtap="selectStaff"
          data-index="{{index}}"
        >
          <image class="staff-photo" src="{{item.photo}}" mode="aspectFill" wx:if="{{item.photo}}" />
          <view class="staff-photo placeholder" wx:else>
            <text>{{item.name.substring(0, 1)}}</text>
          </view>
          <view class="staff-info">
            <text class="staff-name">{{item.name}}</text>
            <text class="staff-position">{{item.position}}</text>
            <text class="staff-workscope" wx:if="{{item.workScope}}">{{item.workScope}}</text>
          </view>
          <view class="staff-status">
            <text wx:if="{{item.hasEvaluated}}" class="evaluated">已评价</text>
            <text wx:else class="arrow">></text>
          </view>
        </view>
        <view class="empty-tip" wx:if="{{staffList.length === 0}}">
          <text>暂无可评价的服务人员</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
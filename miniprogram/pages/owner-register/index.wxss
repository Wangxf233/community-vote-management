.register-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-top: 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999999;
  margin-top: 10rpx;
}

.form-container {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #ff4d4f;
  margin-right: 4rpx;
  font-size: 32rpx;
}

.radio-label {
  display: inline-flex;
  align-items: center;
  font-size: 30rpx;
  color: #333333;
}

.radio-label radio {
  margin-right: 8rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.input:focus {
  border-color: #1aad19;
}

.picker {
  height: 88rpx;
  line-height: 88rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker::after {
  content: "";
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #999999;
  margin-left: 10rpx;
}

.placeholder {
  color: #999999;
}

.tips {
  background: #fff7e6;
  border: 2rpx solid #ffe7ba;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin: 30rpx 0;
  display: flex;
  align-items: flex-start;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  color: #d46b08;
  line-height: 1.6;
}

.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, #1aad19 0%, #4cd964 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 28rpx 0;
  margin-top: 20rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #cccccc;
  opacity: 0.6;
}

.error-tip {
  background: #fff2f0;
  border: 2rpx solid #ffccc7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
}

.error-text {
  font-size: 28rpx;
  color: #ff4d4f;
  line-height: 1.6;
}

.picker.disabled {
  background: #f5f5f5;
  color: #cccccc;
  border-color: #e0e0e0;
}

.input[disabled] {
  background: #f5f5f5;
  color: #cccccc;
}

/* 小区列表样式 */
.community-list {
  position: relative;
  margin-top: 8rpx;
  background: #ffffff;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  max-height: 400rpx;
  z-index: 999;
}

.community-scroll {
  max-height: 400rpx;
}

.community-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  flex-direction: column;
}

.community-item:last-child {
  border-bottom: none;
}

.community-item:active {
  background: #f5f5f5;
}

.community-name {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.community-address {
  font-size: 24rpx;
  color: #999999;
}

.community-list-empty {
  padding: 40rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
  background: #ffffff;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

/* 添加房产按钮 */
.add-property-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #ffffff;
  border: 2rpx dashed #1890ff;
  border-radius: 12rpx;
  color: #1890ff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-property-btn::after {
  border: none;
}

.add-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
  font-weight: bold;
}

/* 房产列表 */
.properties-list {
  margin-top: 30rpx;
  margin-bottom: 30rpx;
}

.list-header {
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.property-item {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.property-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.property-type-badge {
  display: inline-block;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #1890ff;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.property-address {
  font-size: 30rpx;
  color: #333333;
  word-break: break-all;
}

.property-actions {
  margin-left: 16rpx;
}

.delete-btn {
  font-size: 28rpx;
  color: #ff4d4f;
  padding: 8rpx 16rpx;
}

<view class="register-container">
  <view class="header">
    <text class="title">户主注册</text>
    <text class="subtitle">请填写真实信息以便审核</text>
  </view>

  <view class="form-container">
    <view class="form-item">
      <view class="label">
        <text class="required">*</text>
        <text>姓名</text>
      </view>
      <input class="input" placeholder="请输入真实姓名" value="{{formData.name}}" bindinput="onNameInput" />
    </view>

    <view class="form-item">
      <view class="label">
        <text class="required">*</text>
        <text>手机号</text>
      </view>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{formData.phone}}" bindinput="onPhoneInput" bindblur="onPhoneBlur" />
    </view>

    <view class="form-item">
      <view class="label">
        <text class="required">*</text>
        <text>小区名称</text>
      </view>
      <picker mode="region" bindchange="onRegionChange" value="{{region}}">
        <view class="picker">
          <text wx:if="{{region[0]}}">{{region[0]}}{{region[1] && region[1] !== '市辖区' ? ' ' + region[1] : ''}} {{region[2]}}</text>
          <text wx:else class="placeholder">请选择省市区</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <picker mode="selector" range="{{communityList}}" range-key="name" bindchange="onSelectCommunity" disabled="{{communityList.length === 0}}">
        <view class="picker {{communityList.length === 0 ? 'disabled' : ''}}">
          <text wx:if="{{formData.communityName}}">{{formData.communityName}}</text>
          <text wx:else class="placeholder">请选择小区</text>
        </view>
      </picker>
    </view>

    <view class="form-item" wx:if="{{communityNotFound}}">
      <view class="error-tip">
        <text class="error-text">您的小区还未开通服务</text>
      </view>
    </view>

    <view class="form-item" wx:if="{{!communityNotFound && formData.communityName}}">
      <view class="label">
        <text class="required">*</text>
        <text>类型</text>
      </view>
      <radio-group bindchange="onPropertyTypeChange">
        <label class="radio-label">
          <radio value="house" checked="{{formData.propertyType === 'house'}}" />
          <text>房屋</text>
        </label>
        <label class="radio-label" style="margin-left: 30px;">
          <radio value="shop" checked="{{formData.propertyType === 'shop'}}" />
          <text>商铺</text>
        </label>
      </radio-group>
    </view>

    <!-- 房屋类型：楼栋/单元/房号 三级联动（原有逻辑保留） -->
    <block wx:if="{{formData.propertyType === 'house'}}">
      <view class="form-item">
        <view class="label">
          <text class="required">*</text>
          <text>楼栋</text>
        </view>
        <picker mode="selector" range="{{buildings}}" range-key="name" bindchange="onBuildingChange" disabled="{{communityNotFound || buildings.length === 0}}">
          <view class="picker {{communityNotFound || buildings.length === 0 ? 'disabled' : ''}}">
            <text wx:if="{{formData.building}}">{{formData.building}}</text>
            <text wx:else class="placeholder">请选择楼栋</text>
          </view>
        </picker>
      </view>

      <view class="form-item" wx:if="{{units.length > 0}}">
        <view class="label">
          <text class="required">*</text>
          <text>单元</text>
        </view>
        <picker mode="selector" range="{{units}}" range-key="name" bindchange="onUnitChange" disabled="{{communityNotFound}}">
          <view class="picker {{communityNotFound ? 'disabled' : ''}}">
            <text wx:if="{{formData.unit}}">{{formData.unit}}</text>
            <text wx:else class="placeholder">请选择单元</text>
          </view>
        </picker>
      </view>

      <view class="form-item" wx:if="{{rooms.length > 0}}">
        <view class="label">
          <text class="required">*</text>
          <text>房号</text>
        </view>
        <picker mode="selector" range="{{rooms}}" bindchange="onRoomChange" disabled="{{communityNotFound}}">
          <view class="picker {{communityNotFound ? 'disabled' : ''}}">
            <text wx:if="{{formData.room}}">{{formData.room}}</text>
            <text wx:else class="placeholder">请选择房号</text>
          </view>
        </picker>
      </view>
    </block>

    <!-- 商铺类型：门牌号、商铺名两个下拉（后台无配置时对应下拉框置灰、禁止点击） -->
    <block wx:else>
      <view class="form-item">
        <view class="label">
          <text class="required">*</text>
          <text>门牌号</text>
        </view>
        <picker mode="selector" range="{{houseNumbers}}" bindchange="onHouseNumberChange" disabled="{{communityNotFound || houseNumbers.length === 0}}">
          <view class="picker {{communityNotFound || houseNumbers.length === 0 ? 'disabled' : ''}}">
            <text wx:if="{{formData.houseNumber}}">{{formData.houseNumber}}</text>
            <text wx:else class="placeholder">{{communityNotFound ? '请选择门牌号' : (houseNumbers.length === 0 ? '暂无门牌号配置' : '请选择门牌号')}}</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <view class="label">
          <text class="required">*</text>
          <text>商铺名</text>
        </view>
        <picker mode="selector" range="{{shopNames}}" bindchange="onShopNameChange" disabled="{{communityNotFound || shopNames.length === 0}}">
          <view class="picker {{communityNotFound || shopNames.length === 0 ? 'disabled' : ''}}">
            <text wx:if="{{formData.shopName}}">{{formData.shopName}}</text>
            <text wx:else class="placeholder">{{communityNotFound ? '请选择商铺名' : (shopNames.length === 0 ? '暂无商铺名配置' : '请选择商铺名')}}</text>
          </view>
        </picker>
      </view>
    </block>

    <!-- 添加房产/商铺按钮 -->
    <view class="form-item" wx:if="{{!communityNotFound && formData.communityName}}">
      <button class="add-property-btn" bindtap="addProperty">
        <text class="add-icon">+</text> {{formData.propertyType === 'shop' ? '添加商铺' : '添加房产'}}
      </button>
    </view>

    <!-- 已添加的房产/商铺列表 -->
    <view class="properties-list" wx:if="{{properties.length > 0}}">
      <view class="list-header">
        <text class="list-title">已添加{{formData.propertyType === 'shop' ? '商铺' : '房产'}}（{{properties.length}}{{formData.propertyType === 'shop' ? '个' : '套'}}）</text>
      </view>
      <view class="property-item" wx:for="{{properties}}" wx:key="index">
        <view class="property-info">
          <text class="property-type-badge">{{item.propertyType === 'house' ? '房' : '铺'}}</text>
          <text wx:if="{{item.propertyType === 'shop'}}" class="property-address">{{item.houseNumber || '未选门牌号'}}{{item.shopName ? ' ' + item.shopName : ''}}</text>
          <text wx:else class="property-address">{{item.building}}栋 {{item.unit}}单元 {{item.room}}室</text>
        </view>
        <view class="property-actions">
          <text class="delete-btn" bindtap="deleteProperty" data-index="{{index}}">删除</text>
        </view>
      </view>
    </view>

    <view class="tips">
      <text class="tip-icon">ℹ️</text>
      <text class="tip-text">提交后需要管理员审核，审核通常在24小时内完成</text>
    </view>

    <button class="submit-btn" bindtap="handleSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交审核'}}
    </button>
  </view>
</view>

/* 复用 information-list 样式 */
.list-page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.list-container {
  padding: 20rpx;
}

.list-item {
  background: white;
  padding: 32rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
}

.list-item:active {
  transform: scale(0.98);
  background-color: #fafafa;
}

.list-item.pinned {
  border-left: 4rpx solid #1989fa;
}

.item-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
}

.pin-icon {
  display: inline-block;
  font-size: 22rpx;
  color: #1989fa;
  background: #e8f4ff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
  font-weight: 500;
}

.item-title {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.unread-dot {
  width: 12rpx;
  height: 12rpx;
  background: #ff4d4f;
  border-radius: 50%;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.item-content {
  margin-bottom: 20rpx;
}

.content-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-time {
  font-size: 24rpx;
  color: #999;
}

.item-publisher {
  font-size: 24rpx;
  color: #999;
}

.loading-tip {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

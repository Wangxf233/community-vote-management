.basic-info-page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.page-header {
  background: white;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.community-name {
  background: white;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.name-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a73e8;
}

.info-table {
  background: white;
  border-radius: 12rpx;
  overflow: hidden;
}

.table-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row:last-child {
  border-bottom: none;
}

.table-label {
  font-size: 30rpx;
  color: #666;
  flex: 1;
}

.table-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  flex: 1;
}

/* 嵌套行样式 */
.table-row.nested {
  flex-direction: column;
  align-items: stretch;
  padding: 0;
}

.nested-content {
  width: 100%;
}

.nested-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f8f8f8;
}

.nested-row:last-child {
  border-bottom: none;
}

.nested-label {
  font-size: 28rpx;
  color: #888;
  flex: 1;
  padding-left: 40rpx;
}

.nested-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  flex: 1;
}
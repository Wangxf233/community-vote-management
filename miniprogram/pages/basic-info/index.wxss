.basic-info-page {
  background-color: #f5f7fb;
  min-height: 100vh;
  padding: 24rpx;
}

/* ========== 头部 ========== */
.page-header {
  background: linear-gradient(135deg, #1aad19 0%, #22c55e 50%, #16a34a 100%);
  padding: 36rpx 30rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(26, 173, 25, 0.2);
}

.page-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
}

/* ========== 加载和错误 ========== */
.loading-container,
.error-container {
  padding: 120rpx 30rpx;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.error-text {
  font-size: 28rpx;
  color: #f56c6c;
}

/* ========== 信息卡片通用 ========== */
.info-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  padding: 24rpx 28rpx 0;
}

.card-body {
  padding: 20rpx 28rpx 24rpx;
}

/* ========== 信息行 ========== */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row.sub .info-label {
  padding-left: 28rpx;
  font-size: 26rpx;
  color: #9ca3af;
}

.info-row.sub .info-value {
  font-size: 26rpx;
  font-weight: 400;
}

.info-label {
  font-size: 28rpx;
  color: #6b7280;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 600;
  text-align: right;
}

/* ========== 单张图片 ========== */
.single-image {
  width: 100%;
  border-radius: 8rpx;
  background: #f3f4f6;
}

/* ========== 小区介绍 ========== */
.intro-text {
  font-size: 28rpx;
  color: #4b5563;
  line-height: 1.9;
  white-space: pre-wrap;
}

/* ========== 资料图片网格 ========== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.info-image {
  width: 210rpx;
  height: 210rpx;
  border-radius: 8rpx;
  background: #f3f4f6;
}

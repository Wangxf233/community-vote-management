.evaluation-container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #f5f7fa 0%, #ffffff 200rpx);
  padding: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
  padding: 20rpx 30rpx;
  text-align: center;
}

.page-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.back-btn {
  font-size: 28rpx;
  color: #1aad19;
  margin-right: 20rpx;
}

.page-title-small {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  flex: 1;
}

.cycles-list {
  padding: 20rpx 0;
}

.cycle-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.cycle-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.cycle-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  flex: 1;
}

.cycle-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: white;
}

.cycle-tag.ongoing {
  background: linear-gradient(135deg, #1aad19 0%, #4cd964 100%);
}

.cycle-tag.completed {
  background: #95a5a6;
}

.cycle-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.cycle-time {
  font-size: 24rpx;
  color: #7f8c8d;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #95a5a6;
  font-size: 28rpx;
}

.evaluation-info {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-item {
  font-size: 26rpx;
  color: #7f8c8d;
}

.divider {
  height: 20rpx;
  background: transparent;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
}

.section-note {
  font-size: 24rpx;
  color: #95a5a6;
}

.evaluation-content,
.history-content {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
}

.score-section {
  margin-bottom: 40rpx;
}

.score-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.score-label {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.current-score {
  font-size: 28rpx;
  color: #1aad19;
  font-weight: bold;
}

.score-selector {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.score-option {
  width: 60rpx;
  height: 60rpx;
  border-radius: 12rpx;
  background: #ecf0f1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.score-option.selected {
  background: linear-gradient(135deg, #1aad19 0%, #4cd964 100%);
}

.score-option.selected .score-text {
  color: white;
  font-weight: bold;
}

.score-text {
  font-size: 26rpx;
  color: #2c3e50;
}

.score-selector.readonly .score-option {
  pointer-events: none;
}

.score-selector.readonly .score-option.selected {
  background: #d5f4e6;
}

.score-selector.readonly .score-option.selected .score-text {
  color: #1aad19;
}

.comment-section {
  margin-top: 40rpx;
  margin-bottom: 30rpx;
}

.comment-label {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
  margin-bottom: 15rpx;
}

.comment-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #2c3e50;
  box-sizing: border-box;
}

.comment-count {
  text-align: right;
  font-size: 24rpx;
  color: #95a5a6;
  margin-top: 10rpx;
}

.comment-display {
  margin-top: 40rpx;
}

.comment-text {
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #2c3e50;
  line-height: 1.6;
  margin-top: 15rpx;
}

.comment-text.empty {
  color: #95a5a6;
}

.warning-note {
  display: block;
  font-size: 24rpx;
  color: #e74c3c;
  text-align: center;
  margin-bottom: 30rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1aad19 0%, #4cd964 100%);
  color: white;
  font-size: 32rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(26, 173, 25, 0.4);
}

.submit-btn[disabled] {
  opacity: 0.6;
  box-shadow: none;
}

<view class="family-container">

  <!-- 邀请码卡片 -->
  <view class="invite-card">
    <view class="card-title">
      <text class="icon">🎫</text>
      <text>邀请家属</text>
    </view>
    <view class="card-content">
      <view class="invite-code-display" wx:if="{{inviteCode}}">
        <text class="label">邀请码</text>
        <view class="code-box">
          <text class="code">{{inviteCode}}</text>
          <button class="copy-btn" size="mini" bindtap="copyInviteCode">复制</button>
        </view>
        <text class="expires-text">有效期至：{{expiresAt}}</text>
      </view>
      <button class="generate-btn" bindtap="generateInviteCode" disabled="{{generating}}">
        {{generating ? '生成中...' : (inviteCode ? '重新生成' : '生成邀请码')}}
      </button>
    </view>
  </view>

  <!-- 家属列表 -->
  <view class="family-list">
    <view class="list-header">
      <text class="list-title">家庭成员</text>
      <text class="count">共{{familyList.length}}人</text>
    </view>

    <view wx:if="{{loading}}" class="loading">
      <text>加载中...</text>
    </view>

    <view wx:elif="{{familyList.length === 0}}" class="empty">
      <text class="empty-icon">👥</text>
      <text class="empty-text">暂无家属成员</text>
      <text class="empty-hint">生成邀请码后，家属可使用邀请码注册</text>
    </view>

    <view wx:else class="list-items">
      <view class="family-item" wx:for="{{familyList}}" wx:key="_id">
        <view class="item-left">
          <view class="avatar">
            <text class="avatar-icon">👨‍👩‍👧‍👦</text>
          </view>
          <view class="info">
            <text class="name">{{item.name}}</text>
            <text class="relation">{{item.relation || '家属'}}</text>
          </view>
        </view>
        <view class="item-right">
          <text class="phone">{{item.phone}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="family-page">
  <!-- 头部 -->
  <view class="page-header">
    <text class="header-title">我的家属</text>
    <text class="header-count" wx:if="{{familyList.length > 0}}">共 {{familyList.length}} 位家庭成员</text>
  </view>

  <!-- 邀请码卡片 -->
  <view class="invite-section">
    <view class="section-label">邀请家属加入</view>
    <view class="invite-card">
      <view wx:if="{{inviteCode}}" class="code-area">
        <view class="code-row">
          <text class="code-text">{{inviteCode}}</text>
          <view class="code-actions">
            <text class="action-link" bindtap="copyInviteCode">复制</text>
            <text class="action-divider">|</text>
            <button class="action-link share-link" open-type="share">分享</button>
          </view>
        </view>
        <text class="code-expire">有效期至 {{expiresAt}}</text>
      </view>
      <view wx:else class="code-empty">
        <text class="empty-hint">点击下方按钮生成专属邀请码，分享给家人即可加入</text>
      </view>
      <button class="gen-btn" bindtap="generateInviteCode" loading="{{generating}}">
        {{inviteCode ? '重新生成邀请码' : '生成邀请码'}}
      </button>
    </view>
  </view>

  <!-- 家属列表 -->
  <view class="family-section">
    <view class="section-label">家庭成员</view>

    <view wx:if="{{loading}}" class="loading-wrap">
      <text>加载中...</text>
    </view>

    <view wx:elif="{{familyList.length === 0}}" class="empty-wrap">
      <view class="empty-avatar">
        <text class="empty-avatar-text">家</text>
      </view>
      <text class="empty-text">暂无家属成员</text>
      <text class="empty-desc">生成邀请码后，家人扫码或输入邀请码即可加入</text>
    </view>

    <view wx:else class="member-list">
      <view class="member-item" wx:for="{{familyList}}" wx:key="_id">
        <view class="member-avatar">
          <view class="avatar-head"></view>
          <view class="avatar-body"></view>
        </view>
        <view class="member-info">
          <view class="member-name-row">
            <text class="member-name">{{item.name}}</text>
            <text class="member-relation">{{item.relation || '家属'}}</text>
          </view>
          <text class="member-phone">{{item.phone}}</text>
        </view>
        <view class="member-action" catchtap="removeMember" data-id="{{item._id}}" data-name="{{item.name}}">
          <text class="remove-text">移出</text>
        </view>
      </view>
    </view>
  </view>
</view>

<guest-tip></guest-tip>

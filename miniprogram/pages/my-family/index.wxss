.family-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* ========== 头部 ========== */
.page-header {
  padding: 30rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2937;
}

.header-count {
  display: block;
  font-size: 26rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

/* ========== 公共标签 ========== */
.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  padding: 0 0 12rpx 0;
}

/* ========== 邀请码 ========== */
.invite-section {
  margin-bottom: 20rpx;
}

.invite-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.code-area {
  margin-bottom: 20rpx;
}

.code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}

.code-text {
  font-size: 38rpx;
  font-weight: 700;
  color: #333;
  letter-spacing: 6rpx;
  font-family: monospace;
}

.code-actions {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.action-link {
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 16rpx;
}

.action-divider {
  color: #d1d5db;
  font-size: 22rpx;
}

.share-link {
  background: transparent;
  border: none;
  line-height: 1;
  margin: 0;
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  color: #666;
}

.share-link::after {
  border: none;
}

.code-expire {
  font-size: 24rpx;
  color: #9ca3af;
}

.code-empty {
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.6;
}

.gen-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #1aad19;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  padding: 0;
}

.gen-btn::after {
  border: none;
}

.gen-btn[disabled] {
  opacity: 0.6;
}

/* ========== 家属列表 ========== */
.family-section {
  /* no extra margin, page padding handles it */
}

.loading-wrap {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #9ca3af;
}

.empty-wrap {
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.empty-avatar-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #bbb;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #374151;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.6;
}

.member-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
}

.avatar-head {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #c0c4cc;
}

.avatar-body {
  width: 44rpx;
  height: 22rpx;
  border-radius: 22rpx 22rpx 0 0;
  background: #c0c4cc;
  margin-top: 4rpx;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.member-name {
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 600;
}

.member-relation {
  font-size: 22rpx;
  color: #6b7280;
  background: #f3f4f6;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.member-phone {
  display: block;
  font-size: 26rpx;
  color: #9ca3af;
}

.member-action {
  flex-shrink: 0;
  padding: 8rpx 0;
}

.remove-text {
  font-size: 26rpx;
  color: #ef4444;
  padding: 8rpx 20rpx;
  border: 1rpx solid #fecaca;
  border-radius: 32rpx;
}

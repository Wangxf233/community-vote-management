.welcome-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f5e9 0%, #f5f5f5 40%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 顶部 ===== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 30rpx rgba(26, 173, 25, 0.3);
  margin-bottom: 30rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #999;
  letter-spacing: 8rpx;
}

/* ===== 简介卡片 ===== */
.intro-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

.intro-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.intro-item + .intro-item {
  border-top: 1rpx solid #f5f5f5;
}

.intro-num {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  background: #e8f5e9;
  color: #1aad19;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 14rpx;
  text-align: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.intro-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* ===== 提示 ===== */
.bind-tip {
  width: 100%;
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 40rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #ad8b00;
  line-height: 1.6;
}

/* ===== 按钮 ===== */
.actions {
  width: 100%;
  margin-top: auto;
}

.btn-bind {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #1aad19, #22c55e);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 50rpx;
  border: none;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(26, 173, 25, 0.35);
  padding: 0;
}

.btn-bind::after {
  border: none;
}

.btn-guest {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: transparent;
  color: #1aad19;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid #1aad19;
  border-radius: 50rpx;
  padding: 0;
}

.btn-guest::after {
  border: none;
}

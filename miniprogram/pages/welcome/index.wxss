.welcome-container {
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  padding: 160rpx 40rpx 30rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.welcome-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 30rpx;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1aad19;
  margin-bottom: 40rpx;
  text-align: center;
}

.feature-list {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.feature-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.feature-item:last-child {
  margin-bottom: 0;
}

.feature-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.feature-text {
  font-size: 28rpx;
  color: #333333;
}

.bind-tip {
  margin-top: 30rpx;
  width: 100%;
}

.tip-box {
  background: #e8f5e9;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: flex-start;
}

.tip-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #2e7d32;
  line-height: 1.5;
}

.action-buttons {
  margin-top: auto;
  padding-top: 30rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #1aad19, #4cd964);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #ffffff;
  color: #1aad19;
  font-size: 28rpx;
  border: 2rpx solid #1aad19;
  border-radius: 50rpx;
  padding: 20rpx 0;
}

.btn-secondary::after {
  border: none;
}

<view class="welcome-container">
  <view class="welcome-content">
    <image src="/images/welcome-logo.png" class="logo" mode="aspectFit"></image>
    
    <view class="welcome-title">欢迎使用业主投票评价系统</view>
    
    <view class="feature-list">
      <view class="feature-item">
        <image src="/images/welcome-vote.png" class="feature-icon"></image>
        <text class="feature-text">参与社区投票决策</text>
      </view>
      <view class="feature-item">
        <image src="/images/welcome-star.png" class="feature-icon"></image>
        <text class="feature-text">物业服务评价反馈</text>
      </view>
      <view class="feature-item">
        <image src="/images/welcome-repair.png" class="feature-icon"></image>
        <text class="feature-text">便捷报修报事服务</text>
      </view>
      <view class="feature-item">
        <image src="/images/welcome-notice.png" class="feature-icon"></image>
        <text class="feature-text">及时接收重要通知</text>
      </view>
    </view>

    <view class="bind-tip">
      <view class="tip-box">
        <image src="/images/welcome-tip.png" class="tip-icon"></image>
        <text class="tip-text">绑定后可使用投票、评价、报修等功能，审核通常在24小时内完成</text>
      </view>
    </view>
  </view>

  <view class="action-buttons">
    <button class="btn-primary" bindtap="goToSelectIdentity">立即绑定</button>
    <button class="btn-secondary" bindtap="enterAsGuest">先看看</button>
  </view>
</view>

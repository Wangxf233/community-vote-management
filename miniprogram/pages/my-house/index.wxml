<view class="my-house-page">
  <view class="header">
    <text class="title">我的房屋</text>
    <text class="subtitle">共 {{houseList.length}} 套房产</text>
  </view>

  <!-- 房产列表 -->
  <view class="house-list">
    <view class="house-card" wx:for="{{houseList}}" wx:key="_id">
      <view class="card-header">
        <text class="house-title">房产 {{index + 1}}</text>
        <text class="status-tag {{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="card-body">
        <view class="info-row">
          <text class="label">区/期号：</text>
          <text class="value">{{item.district || item.region || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="label">楼栋号：</text>
          <text class="value">{{item.building || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="label">单元号：</text>
          <text class="value">{{item.unit || item.block || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="label">房号：</text>
          <text class="value">{{item.room || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="label">专有面积：</text>
          <text class="value highlight">{{item.area || '-'}} {{item.area ? '㎡' : ''}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{houseList.length === 0 && !loading}}">
    <image src="/images/icon-empty.png" mode="aspectFit" class="empty-icon"/>
    <text class="empty-text">暂无房产信息</text>
    <text class="empty-hint">请先完成实名认证</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>

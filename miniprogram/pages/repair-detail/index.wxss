.repair-container {
  padding: 30rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}

.content-section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 页面头部 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.status-wrapper {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.status-tag {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-tag.pending {
  background-color: #fff0f0;
  color: #ff6b6b;
}

.status-tag.processing {
  background-color: #e7f5ff;
  color: #1890ff;
}

.status-tag.completed {
  background-color: #f0fdf4;
  color: #22c55e;
}

.status-tag.rejected {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.urgency-tag {
  font-size: 24rpx;
  color: #ff6b6b;
  background: #fff0f0;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 表单样式 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.form-value {
  padding: 24rpx;
  background: #f8f9fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  min-height: 48rpx;
  line-height: 1.6;
}

.form-value.description {
  min-height: 200rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #e0e0e0, transparent);
  margin: 40rpx 0;
}

/* 上传区域 */
.upload-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 24rpx;
  display: block;
}

.image-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.video-uploader {
  display: flex;
}

.video-item-full {
  width: 100%;
  border-radius: 12rpx;
  overflow: hidden;
}

.uploaded-video {
  width: 100%;
  height: 400rpx;
}

/* 信息展示 */
.info-section {
  margin-top: 32rpx;
}

.info-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  min-width: 160rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  word-break: break-all;
}

/* 备注 */
.remark-section {
  margin-top: 32rpx;
}

.remark-content {
  padding: 24rpx;
  background: #f8f9fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 底部按钮 */
.cancel-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff5252);
  color: white;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 40rpx;
  box-shadow: 0 8rpx 16rpx rgba(255, 107, 107, 0.3);
}

.cancel-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

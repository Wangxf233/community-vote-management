/* 复用挪车页样式，保持一致 */
.query-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 输入区域 */
.plate-input-area {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.plate-label {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 20rpx;
}

.plate-display {
  display: flex;
  justify-content: center;
  gap: 8rpx;
}

.plate-box {
  width: 70rpx;
  height: 80rpx;
  border: 4rpx solid #d9d9d9;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  background: #fff;
  transition: all 0.2s;
}

.plate-box.active {
  border-color: #1AAD19;
  border-width: 6rpx;
  background: #f0fdf0;
}

.plate-box.filled {
  border-color: #1890ff;
  color: #1890ff;
}

/* 键盘区域 */
.keyboard-area {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.key-section {
  margin-bottom: 16rpx;
}

.key-section-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
  padding-left: 4rpx;
}

.key-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.province-grid {
  gap: 4rpx;
}

.key-btn {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  background: #fff;
  color: #333;
  box-sizing: border-box;
  transition: all 0.15s;
}

.key-btn:active {
  background: #e6f7ff;
  border-color: #1890ff;
  transform: scale(0.95);
}

.province-btn {
  border-color: #1890ff;
  color: #1890ff;
  font-weight: 600;
  width: 60rpx;
  height: 60rpx;
  font-size: 24rpx;
}

.letter-btn {
  border-color: #d9d9d9;
  color: #555;
}

.number-btn {
  border-color: #d9d9d9;
  color: #333;
  font-weight: 700;
  font-size: 28rpx;
}

/* 操作按钮 */
.key-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.action-btn {
  flex: 1;
  height: 70rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.delete-btn {
  border-color: #ff4d4f;
  color: #ff4d4f;
}

.clear-btn {
  border-color: #ff7875;
  color: #ff7875;
}

/* 确认按钮 */
.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1AAD19;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  border: none;
}

.confirm-btn[disabled] {
  background: #a0d9a0;
}

/* 查询结果 */
.result-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f9f9f9;
}

.result-label {
  font-size: 26rpx;
  color: #999;
}

.result-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  max-width: 60%;
}

.result-value.highlight {
  color: #1890ff;
  font-weight: 600;
}

.result-tip {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #fff7e6;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #fa8c16;
  text-align: center;
}

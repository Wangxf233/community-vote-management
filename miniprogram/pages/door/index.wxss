.door-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.header-card {
  padding: 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1aad19, #22c55e);
  color: #ffffff;
  margin-bottom: 20rpx;
}

.header-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  opacity: 0.95;
  margin-top: 8rpx;
}

.status-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #fff8e1;
  color: #7a5c00;
  margin-bottom: 16rpx;
}

.status-banner.rejected {
  background: #ffebee;
  color: #9a1f1f;
}

.status-banner.guest {
  background: #e8f4ff;
  color: #134b7a;
}

.bind-btn {
  margin: 0;
  line-height: 1.8;
  font-size: 24rpx;
}

.loading-wrap,
.empty-wrap {
  text-align: center;
  color: #7b8190;
  padding: 80rpx 0;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.device-main {
  flex: 1;
  margin-right: 20rpx;
}

.device-name {
  display: block;
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 600;
}

.device-location {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.device-serial {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.open-btn {
  width: 148rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.device-item.demo {
  opacity: 0.7;
  border: 2rpx dashed #d9d9d9;
}

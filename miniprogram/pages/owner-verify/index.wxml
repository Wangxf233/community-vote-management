<view class="owner-verify-container">
  <view class="progress-bar">
    <view class="progress-step {{step >= 1 ? 'active' : ''}}">
      <view class="step-circle">1</view>
      <text class="step-label">授权手机号</text>
    </view>
    <view class="progress-line {{step >= 2 ? 'active' : ''}}"></view>
    <view class="progress-step {{step >= 2 ? 'active' : ''}}">
      <view class="step-circle">2</view>
      <text class="step-label">实名认证</text>
    </view>
    <view class="progress-line {{step >= 3 ? 'active' : ''}}"></view>
    <view class="progress-step {{step >= 3 ? 'active' : ''}}">
      <view class="step-circle">3</view>
      <text class="step-label">上传证明</text>
    </view>
    <view class="progress-line {{step >= 4 ? 'active' : ''}}"></view>
    <view class="progress-step {{step >= 4 ? 'active' : ''}}">
      <view class="step-circle">4</view>
      <text class="step-label">等待审核</text>
    </view>
  </view>

  <!-- 步骤1: 授权手机号 -->
  <view wx:if="{{step === 1}}" class="step-content">
    <view class="step-header">
      <image src="/images/phone-icon.png" class="step-icon" mode="aspectFit" />
      <text class="step-title">授权手机号</text>
      <text class="step-desc">用于接收审核通知和投票提醒</text>
    </view>
    <view class="action-area">
      <button class="primary-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
        授权获取手机号
      </button>
    </view>
  </view>

  <!-- 步骤2: 实名认证 -->
  <view wx:if="{{step === 2}}" class="step-content">
    <view class="step-header">
      <image src="/images/verify-icon.png" class="step-icon" mode="aspectFit" />
      <text class="step-title">实名认证</text>
      <text class="step-desc">请进行微信实名认证,确保信息真实性</text>
    </view>

    <view class="info-display">
      <view class="info-item">
        <text class="info-label">手机号</text>
        <text class="info-value">{{phone}}</text>
      </view>
      <view class="info-item" wx:if="{{realName}}">
        <text class="info-label">姓名</text>
        <text class="info-value">{{realName}}</text>
      </view>
      <view class="info-item" wx:if="{{idCardLast4}}">
        <text class="info-label">身份证</text>
        <text class="info-value">******{{idCardLast4}}</text>
      </view>
    </view>

    <view class="action-area">
      <button wx:if="{{!realName}}" class="primary-btn" bindtap="doRealNameVerify">
        开始实名认证
      </button>
      <button wx:else class="primary-btn" bindtap="nextStep">
        下一步
      </button>
    </view>
  </view>

  <!-- 步骤3: 上传房产证明 -->
  <view wx:if="{{step === 3}}" class="step-content">
    <view class="step-header">
      <image src="/images/upload-icon.png" class="step-icon" mode="aspectFit" />
      <text class="step-title">上传房产证明</text>
      <text class="step-desc">请上传以下任一材料(支持多张)</text>
    </view>

    <view class="proof-types">
      <view class="proof-type-item">
        <text class="proof-icon">📄</text>
        <text class="proof-name">房产证</text>
      </view>
      <view class="proof-type-item">
        <text class="proof-icon">📋</text>
        <text class="proof-name">购房合同</text>
      </view>
      <view class="proof-type-item">
        <text class="proof-icon">🧾</text>
        <text class="proof-name">全款发票</text>
      </view>
      <view class="proof-type-item">
        <text class="proof-icon">📑</text>
        <text class="proof-name">交房证明</text>
      </view>
    </view>

    <view class="house-info">
      <text class="house-label">您申请的房屋信息:</text>
      <text class="house-value">{{communityName}} {{building}}栋{{unit}}单元{{room}}室</text>
    </view>

    <view class="upload-area">
      <view class="image-list">
        <view wx:for="{{proofImages}}" wx:key="index" class="image-item">
          <image src="{{item}}" mode="aspectFill" class="uploaded-image" bindtap="previewImage" data-url="{{item}}" />
          <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">×</view>
        </view>
        <view wx:if="{{proofImages.length < 6}}" class="upload-btn" bindtap="chooseImage">
          <text class="upload-icon">+</text>
          <text class="upload-text">添加图片</text>
        </view>
      </view>
      <text class="upload-tip">最多上传6张,每张不超过5MB</text>
    </view>

    <view class="action-area">
      <button class="secondary-btn" bindtap="prevStep">上一步</button>
      <button class="primary-btn" bindtap="submitBinding" disabled="{{proofImages.length === 0 || submitting}}">
        {{submitting ? '提交中...' : '提交审核'}}
      </button>
    </view>
  </view>

  <!-- 步骤4: 提交成功 -->
  <view wx:if="{{step === 4}}" class="step-content">
    <view class="success-content">
      <image src="cloud://cloud1-6ghienoi526fff51.636c-cloud1-6ghienoi526fff51-1325504194/images/success.png" class="success-icon" mode="aspectFit" />
      <text class="success-title">提交成功</text>
      <text class="success-desc">您的认证申请已提交,管理员会在1-3个工作日内完成审核</text>
      
      <view class="status-card">
        <view class="status-item">
          <text class="status-label">申请类型</text>
          <text class="status-value">户主认证</text>
        </view>
        <view class="status-item">
          <text class="status-label">房屋信息</text>
          <text class="status-value">{{communityName}} {{building}}栋{{unit}}单元{{room}}室</text>
        </view>
        <view class="status-item">
          <text class="status-label">提交时间</text>
          <text class="status-value">{{submitTime}}</text>
        </view>
      </view>

      <view class="action-area">
        <button class="primary-btn" bindtap="goHome">返回首页</button>
      </view>
    </view>
  </view>
</view>

<guest-tip></guest-tip>

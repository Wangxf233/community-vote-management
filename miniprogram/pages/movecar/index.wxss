/* 挪车页面样式 */

.movecar-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

/* ========== 标题卡片 ========== */
.header-card {
  padding: 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1aad19, #22c55e);
  color: #ffffff;
  margin-bottom: 24rpx;
}

.header-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  opacity: 0.95;
  margin-top: 8rpx;
}

/* ========== 车牌输入展示区 ========== */
.plate-input-area {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  text-align: center;
}

.plate-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.plate-slots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.plate-slot {
  width: 70rpx;
  height: 70rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  background: #fafbfc;
  transition: all 0.2s ease;
}

.plate-slot.slot-active {
  border-color: #1890ff;
  border-width: 3rpx;
  background: #e6f7ff;
  box-shadow: 0 0 0 4rpx rgba(24, 144, 255, 0.12);
}

.plate-slot.slot-filled {
  border-color: #52c41a;
  background: #f6ffed;
  color: #1f2937;
}

.plate-hint {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 16rpx;
}

.plate-hint.full {
  color: #52c41a;
  font-weight: 500;
}

/* ========== 键盘区域 ========== */
.keyboard-area {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 16rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

/* ========== 步骤指示器 ========== */
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  background: #f5f5f5;
  color: #bbb;
  transition: all 0.25s ease;
}

.step-dot.step-active {
  background: #1890ff;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.step-dot.step-done {
  background: #52c41a;
  color: #fff;
}

.step-dot.step-next {
  border: 2rpx dashed #d9d9d9;
  background: #fff;
  color: #999;
}

.step-line {
  width: 60rpx;
  height: 4rpx;
  background: #eee;
  margin: 0 6rpx;
  transition: background 0.25s ease;
}

.step-line.step-done {
  background: #52c41a;
}

/* ========== 键盘区域标题 ========== */
.keyboard-section {
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 14rpx;
  text-align: center;
}

/* ========== 按键网格 ========== */
.key-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

/* ========== 按键基础样式 ========== */
.key-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  background: #ffffff;
  box-sizing: border-box;
  border-radius: 12rpx;
  transition: all 0.12s ease;
  flex-shrink: 0;
}

.key-btn:active {
  transform: scale(0.93);
}

/* 省份按键 */
.key-province {
  width: 78rpx;
  height: 66rpx;
  margin: 7rpx 6rpx;
  font-size: 28rpx;
  color: #1890ff;
  border: 2rpx solid #b3d8ff;
  background: #f5f9ff;
}

.key-province:active {
  background: #d6ebff;
  border-color: #1890ff;
}

/* 字母按键 */
.key-letter {
  width: 68rpx;
  height: 60rpx;
  margin: 6rpx 5rpx;
  font-size: 28rpx;
  color: #555;
  border: 2rpx solid #e8e8e8;
  background: #fafafa;
}

.key-letter:active {
  background: #e6f7ff;
  border-color: #91d5ff;
  color: #1890ff;
}

/* 数字行 */
.number-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 16rpx;
}

/* 数字按键 - 大且醒目 */
.key-number {
  width: 64rpx;
  height: 68rpx;
  margin: 8rpx 7rpx;
  font-size: 32rpx;
  color: #1f2937;
  border: 2rpx solid #d0d5dd;
  background: #ffffff;
  font-weight: 700;
  border-radius: 12rpx;
}

.key-number:active {
  background: #e6f7ff;
  border-color: #1890ff;
}

/* 字母行 */
.letter-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

/* 字母按键（混合模式 — 与数字同等醒目） */
.key-letter-mix {
  width: 64rpx;
  height: 60rpx;
  margin: 6rpx 5rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #555;
  border: 2rpx solid #d0d5dd;
  background: #ffffff;
  border-radius: 12rpx;
}

.key-letter-mix:active {
  background: #e6f7ff;
  border-color: #1890ff;
  color: #1890ff;
}

/* 省份网格（31格） */
.province-grid {
  padding: 0 8rpx;
}

/* ========== 操作按钮 ========== */
.action-row {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 18rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.12s ease;
}

.action-btn:active {
  transform: scale(0.96);
}

.action-back {
  background: #fff2f0;
  border: 2rpx solid #ffccc7;
  color: #ff4d4f;
}

.action-back:active {
  background: #ffd8d5;
}

.action-reset {
  background: #f5f5f5;
  border: 2rpx solid #e8e8e8;
  color: #666;
}

.action-reset:active {
  background: #e8e8e8;
}

/* ========== 确认查询按钮 ========== */
.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #1aad19, #22c55e);
  border: none;
  padding: 0;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 20rpx rgba(26, 173, 25, 0.3);
}

.confirm-btn:active {
  opacity: 0.9;
}

.confirm-btn[disabled] {
  background: #d9d9d9;
  color: #8c8c8c;
  box-shadow: none;
}

.confirm-btn.button-loading {
  background: #b7eb8f;
}

/* ========== 查询结果区域 ========== */
.result-area {
  margin-top: 8rpx;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.result-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.08);
}

.result-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid #f0f0f0;
  text-align: center;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.result-row:last-of-type {
  border-bottom: none;
}

.result-label {
  font-size: 26rpx;
  color: #8c8c8c;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.result-value {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}

.result-value.plate-number {
  font-weight: 700;
  color: #1890ff;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.result-value.phone-value {
  color: #595959;
}

.result-value.remark-value {
  color: #fa8c16;
  font-style: italic;
}

/* 联系车主按钮 */
.call-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #1aad19, #22c55e);
  border: none;
  padding: 0;
  margin-top: 24rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 20rpx rgba(26, 173, 25, 0.3);
}

.call-btn:active {
  opacity: 0.9;
}

/* 普通用户简洁结果卡 */
.simple-result {
  text-align: center;
}

.result-icon {
  font-size: 80rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.result-tip {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 16rpx;
}

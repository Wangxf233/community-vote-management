.bind-container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 步骤指示器 */
.steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  padding: 30rpx 40rpx;
  border-radius: 10rpx;
  margin-bottom: 24rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.step-number {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  transition: all 0.3s;
}

.step.active .step-number {
  background: #1aad19;
  color: white;
}

.step-text {
  font-size: 22rpx;
  color: #999;
  transition: color 0.3s;
}

.step.active .step-text {
  color: #1aad19;
  font-weight: 600;
}

.step-line {
  flex: 1;
  height: 2rpx;
  background: #e0e0e0;
  margin: 0 12rpx;
  margin-bottom: 30rpx;
}

/* 步骤内容 */
.step-content {
  background: white;
  border-radius: 10rpx;
  padding: 32rpx;
}

.step-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.step-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.step-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* Step 1: 手机号授权 */
.phone-box {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.phone-btn {
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #1aad19;
  color: white;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}

.bind-form {
  background: white;
  padding: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 18rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.input,
.picker-row {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 18rpx;
  font-size: 28rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  box-sizing: border-box;
  background: #fff;
}

.community-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

/* 包裹器用于将候选下拉做绝对定位 */
.community-wrapper {
  position: relative;
}

.mini-btn {
  padding: 12rpx 14rpx;
  background: #1aad19;
  color: white;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.loc-icon {
  width: 65rpx;
  height: 65rpx;
  border-radius: 28rpx;
  padding: 10rpx;
  box-sizing: border-box;
}

/* 候选下拉样式 */
.candidates-list {
  position: absolute;
  left: 0;
  right: 0;
  top: 78rpx; /* 距离输入框下方，略大于 input 的高度以留出间隙 */
  z-index: 1000;
  background: #fff;
  border: 1rpx solid #e6e6e6;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  /* 初始为隐藏状态（透明+上移），通过 .show 类触发展示动画 */
  opacity: 0;
  transform: translateY(-8rpx);
  transition: opacity 180ms ease, transform 180ms ease;
}

.candidates-scroll {
  max-height: 360rpx; /* 超高时滚动 */
}

.candidate-item {
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fff;
}

.candidate-item:last-child {
  border-bottom: none;
}

.candidate-item:active {
  background: #f5f7fa;
}

.cand-name {
  color: #333;
  font-size: 28rpx;
}

.cand-region {
  color: #999;
  font-size: 22rpx;
}

/* 全屏透明遮罩，用于捕获外部点击以关闭下拉（遮罩置于页面内容之上、下拉之下） */
.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 900; /* 比 .candidates-list 的 1000 低，这样下拉保留在遮罩之上可点击 */
  background: rgba(0, 0, 0, 0); /* 初始透明，通过 .show 提供轻微遮罩 */
  transition: opacity 180ms ease;
}

/* 展示状态 */
.candidates-list.show {
  opacity: 1;
  transform: translateY(0);
}
.candidates-list.hide {
  opacity: 0;
  transform: translateY(-8rpx);
}
.overlay.show {
  opacity: 0.06;
}
.overlay.hide {
  opacity: 0;
}

.hint {
  color: #e74c3c;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.status {
  color: #1aad19;
  font-size: 28rpx;
  font-weight: 600;
}

.status-fail {
  color: #e74c3c;
  font-size: 26rpx;
}

.form-actions {
  display: flex;
  justify-content: center;
  margin-top: 10rpx;
}

.submit-btn {
  width: 90%;
  height: 88rpx;
  border-radius: 44rpx;
  background: #1aad19;
  color: white;
  font-size: 30rpx;
  border: none;
}

.submit-btn:disabled {
  opacity: 0.6;
}

/* Step 3: 状态页 */
.status-box {
  padding: 60rpx 0;
  text-align: center;
}

.status-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
}

.status-title {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.status-pending .status-title {
  color: #ff9800;
}

.status-success .status-title {
  color: #1aad19;
}

.status-fail .status-title {
  color: #e74c3c;
}

.status-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 48rpx;
  padding: 0 40rpx;
}

.back-btn {
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #1aad19;
  color: white;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
  margin: 0 auto;
}

.input.disabled {
  background: #f5f5f5;
  color: #999;
}

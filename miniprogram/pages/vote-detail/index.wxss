.vote-detail-container {
  min-height: 100vh;
  background-color: #f8f9fa;
}

.detail-content {
  height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 投票头部 */
.vote-header {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
}

.vote-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  line-height: 1.4;
  margin-right: 20rpx;
}

.status-container {
  flex-shrink: 0;
}

.vote-status {
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.vote-status.ongoing {
  background: #e8f5e8;
  color: #07c160;
  border: 1rpx solid #07c160;
}

.vote-status.ended {
  background: #f8f8f8;
  color: #999;
  border: 1rpx solid #e0e0e0;
}

.vote-status.voted {
  background: #e8f5e8;
  color: #07c160;
  border: 1rpx solid #07c160;
}

/* 通用区块样式 */
.section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 24rpx;
  display: block;
  border-left: 6rpx solid #07c160;
  padding-left: 16rpx;
}

.content-box {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 28rpx;
  border: 1rpx solid #e8e8e8;
}

/* 投票详情样式 */
.vote-description {
  font-size: 28rpx;
  color: #4a4a4a;
  line-height: 1.8;
  white-space: pre-line;
}

/* 附件样式 */
.attachments {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.attachment-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: white;
  border-radius: 12rpx;
  border: 1rpx solid #e8e8e8;
  transition: all 0.3s;
}

.attachment-item:active {
  background: #f0f0f0;
}

.attachment-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.attachment-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.attachment-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.attachment-size {
  font-size: 24rpx;
  color: #999;
  background: #f0f0f0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

/* 元信息样式 */
.meta-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-label {
  font-size: 28rpx;
  color: #666;
  width: 160rpx;
  font-weight: 500;
}

.meta-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.meta-value.deadline {
  color: #ff4757;
  font-weight: bold;
}

/* 投票选项样式 */
.vote-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: white;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.option-item.selected {
  border-color: #07c160;
  background: #f8fff8;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.1);
}

.option-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.option-radio {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 50%;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.option-item.selected .option-radio {
  border-color: #07c160;
  background: #07c160;
}

.radio-dot {
  width: 20rpx;
  height: 20rpx;
  background: white;
  border-radius: 50%;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 投票结果样式 */
.vote-results {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.result-item {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.option-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.vote-percent {
  font-size: 26rpx;
  color: #07c160;
  font-weight: bold;
}

.progress-container {
  width: 100%;
}

/* 进度条基础样式 */
.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #1aad19, #4cd964);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 动态宽度类 */
.progress-0 {
  width: 0%;
}
.progress-5 {
  width: 5%;
}
.progress-10 {
  width: 10%;
}
.progress-15 {
  width: 15%;
}
.progress-20 {
  width: 20%;
}
.progress-25 {
  width: 25%;
}
.progress-30 {
  width: 30%;
}
.progress-35 {
  width: 35%;
}
.progress-40 {
  width: 40%;
}
.progress-45 {
  width: 45%;
}
.progress-50 {
  width: 50%;
}
.progress-55 {
  width: 55%;
}
.progress-60 {
  width: 60%;
}
.progress-65 {
  width: 65%;
}
.progress-70 {
  width: 70%;
}
.progress-75 {
  width: 75%;
}
.progress-80 {
  width: 80%;
}
.progress-85 {
  width: 85%;
}
.progress-90 {
  width: 90%;
}
.progress-95 {
  width: 95%;
}
.progress-100 {
  width: 100%;
}

.total-votes {
  text-align: center;
  font-size: 26rpx;
  color: #666;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e8e8e8;
  font-weight: 500;
}

/* 参与统计信息 */
.participant-stats {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e8e8e8;
}

.stats-item {
  display: flex;
  align-items: baseline;
  font-size: 26rpx;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.stats-item:last-child {
  margin-bottom: 0;
}

.stats-label {
  color: #666;
  font-weight: 500;
}

.stats-value {
  color: #07c160;
  font-weight: bold;
  font-size: 28rpx;
  margin: 0 8rpx;
}

.stats-ratio {
  color: #999;
  font-size: 24rpx;
}

/* 投票按钮 */
.vote-actions {
  padding: 32rpx;
  background: white;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
}

.vote-btn {
  background: linear-gradient(135deg, #07c160, #4cd964);
  color: white;
  border: none;
  border-radius: 16rpx;
  padding: 14rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s;
}

.vote-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.vote-btn:disabled {
  background: #ccc;
  box-shadow: none;
  transform: none;
}

/* 投票说明 */
.vote-instruction {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  white-space: pre-line;
}

/* 我的投票记录 */
.my-vote-record {
  background: linear-gradient(135deg, #f8fff8, #e8f5e8);
  border: 1rpx solid #07c160;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  display: flex;
  align-items: center;
}

.record-label {
  font-size: 26rpx;
  color: #666;
  width: 160rpx;
}

.record-value {
  font-size: 26rpx;
  color: #07c160;
  font-weight: bold;
  flex: 1;
}

<view class="vote-detail-container">
  <scroll-view class="detail-content" scroll-y>
    <!-- 投票标题和基本信息 -->
    <view class="vote-header">
      <text class="vote-title"># {{voteDetail.title}}</text>
      <view class="status-container">
        <text class="vote-status {{voteDetail.status}}">{{voteDetail.statusText}}</text>
      </view>
    </view>

    <!-- 投票详情 -->
    <view class="section">
      <text class="section-title">详情</text>
      <view class="content-box">
        <text class="vote-description">{{voteDetail.description}}</text>
      </view>
    </view>

    <!-- 附件 -->
    <view class="section" wx:if="{{voteDetail.attachments && voteDetail.attachments.length > 0}}">
      <text class="section-title">附件</text>
      <view class="content-box">
        <view class="attachments">
          <view class="attachment-item" wx:for="{{voteDetail.attachments}}" wx:key="id" bindtap="previewAttachment" data-url="{{item.url}}">
            <view class="attachment-left">
              <image src="cloud://cloud1-6ghienoi526fff51.636c-cloud1-6ghienoi526fff51-1325504194/images/file-icon.png" class="attachment-icon"></image>
              <text class="attachment-name">{{item.name}}</text>
            </view>
            <text class="attachment-size">{{item.size}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 发起人信息 -->
    <view class="section">
      <text class="section-title">基本信息</text>
      <view class="content-box">
        <view class="meta-grid">
          <view class="meta-row">
            <text class="meta-label">发起人：</text>
            <text class="meta-value">{{voteDetail.sponsor}}</text>
          </view>
          <view class="meta-row">
            <text class="meta-label">发布时间：</text>
            <text class="meta-value">{{voteDetail.publishTime}}</text>
          </view>
          <view class="meta-row">
            <text class="meta-label">截止时间：</text>
            <text class="meta-value deadline">{{voteDetail.deadlineTime}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 投票选项 -->
    <view class="section" wx:if="{{!voteDetail.hasVoted && voteDetail.status === 'ongoing'}}">
      <text class="section-title">投票选项</text>
      <view class="content-box">
        <view class="vote-options">
          <view class="option-item {{selectedOption === index ? 'selected' : ''}}" 
                wx:for="{{voteDetail.options}}" 
                wx:key="id"
                bindtap="selectOption"
                data-index="{{index}}">
            <view class="option-left">
              <view class="option-radio">
                <text class="radio-dot" wx:if="{{selectedOption === index}}"></text>
              </view>
              <text class="option-text">{{item.text}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 手写签名 -->
    <view class="section" wx:if="{{!voteDetail.hasVoted && voteDetail.status === 'ongoing'}}">
      <signature-pad id="signaturePad" title="手写签名"></signature-pad>
    </view>

    <!-- 投票结果：已截止总是显示；已投且管理员允许显示时显示 -->
    <view class="section" wx:if="{{(voteDetail.hasVoted && voteDetail.showResult) || voteDetail.status === 'ended'}}">
      <text class="section-title">投票结果</text>
      <view class="content-box">
        <view class="vote-results">
          <view class="result-item" wx:for="{{voteDetail.options}}" wx:key="id">
            <view class="result-header">
              <text class="option-text">{{item.text}}</text>
              <text class="vote-percent">{{item.percent}}% ({{item.count}}票)</text>
            </view>
            <view class="progress-container">
              <view class="progress-bar">
                <view class="progress-inner progress-{{item.percent}}"></view>
              </view>
            </view>
          </view>
        </view>
        <view class="total-votes">
          总投票数：{{voteDetail.totalVotes}}票
        </view>
      </view>
    </view>

    <!-- 投票按钮 -->
    <view class="vote-actions" wx:if="{{!voteDetail.hasVoted && voteDetail.status === 'ongoing'}}">
      <button class="vote-btn" bindtap="submitVote" disabled="{{selectedOption === null}}">
        提交投票
      </button>
    </view>

    <!-- 投票说明 -->
    <view class="section">
      <text class="section-title">投票说明</text>
      <view class="content-box">
        <text class="vote-instruction">{{voteDetail.instruction}}</text>
      </view>
    </view>

    <!-- 我的投票记录 -->
    <view class="section" wx:if="{{voteDetail.hasVoted}}">
      <text class="section-title">我的投票记录</text>
      <view class="content-box">
        <view class="my-vote-record">
          <view class="record-item">
            <text class="record-label">您选择了：</text>
            <text class="record-value">{{myVoteRecord.optionText}}</text>
          </view>
          <view class="record-item">
            <text class="record-label">投票时间：</text>
            <text class="record-value">{{myVoteRecord.voteTime}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
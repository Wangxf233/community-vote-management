.staff-register-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-top: 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999999;
  margin-top: 10rpx;
}

.form-container {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #ff4d4f;
  margin-right: 4rpx;
  font-size: 32rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.input:focus {
  border-color: #1aad19;
}

.picker {
  height: 88rpx;
  line-height: 88rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker::after {
  content: "";
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #999999;
  margin-left: 10rpx;
}

.placeholder {
  color: #999999;
}

/* 小区列表 */
.community-list {
  position: relative;
  margin-top: 8rpx;
  background: #ffffff;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  max-height: 400rpx;
  z-index: 999;
}

.community-scroll {
  max-height: 400rpx;
}

.community-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  flex-direction: column;
}

.community-item:last-child {
  border-bottom: none;
}

.community-item:active {
  background: #f5f5f5;
}

.community-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.community-address {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.community-list-empty {
  position: relative;
  margin-top: 8rpx;
  background: #ffffff;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
}

.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, #1aad19 0%, #4cd964 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 28rpx 0;
  margin-top: 20rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #cccccc;
  opacity: 0.6;
}

.tips {
  background: #fff7e6;
  border: 2rpx solid #ffe7ba;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin: 30rpx 0;
  display: flex;
  align-items: flex-start;
}

.tips-title {
  font-size: 26rpx;
  color: #d46b08;
  line-height: 1.6;
  font-weight: 600;
}

.tips-text {
  font-size: 26rpx;
  color: #d46b08;
  line-height: 1.6;
}

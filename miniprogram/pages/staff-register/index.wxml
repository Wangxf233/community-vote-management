<view class="staff-register-container">
  <view class="form-card">
    <view class="form-title">工作人员注册</view>
    <view class="form-desc">提交后将由物业管理员审核</view>

    <view class="form-group">
      <view class="form-label">姓名</view>
      <input class="form-input" placeholder="请输入姓名" value="{{name}}" bindinput="onNameInput" maxlength="20" />
    </view>

    <view class="form-group">
      <view class="form-label">手机号</view>
      <input class="form-input" type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" maxlength="11" />
    </view>

    <view class="form-group">
      <view class="form-label">职位</view>
      <input class="form-input" placeholder="请输入职位（如保安、清洁工）" value="{{position}}" bindinput="onPositionInput" maxlength="30" />
    </view>

    <view class="form-group">
      <view class="form-label">所属小区</view>
      <picker mode="selector" range="{{communityList}}" range-key="name" bindchange="onCommunityChange">
        <view class="form-picker {{selectedCommunity ? '' : 'placeholder'}}">
          {{selectedCommunity ? selectedCommunity : '请选择小区'}}
        </view>
      </picker>
    </view>

    <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">
      提交审核
    </button>

    <view class="tips">
      <text class="tips-title">温馨提示：</text>
      <text class="tips-text">· 提交后需等待管理员审核通过才能使用工作人员功能</text>
      <text class="tips-text">· 请确保填写的手机号真实有效</text>
    </view>
  </view>
</view>

<guest-tip></guest-tip>

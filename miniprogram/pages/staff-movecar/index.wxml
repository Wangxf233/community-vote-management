<view class="movecar-page">
  <!-- 标题区域 -->
  <view class="header-card">
    <text class="header-title">车辆查询</text>
    <text class="header-subtitle">输入车牌号查看车辆全部信息</text>
  </view>

  <!-- 车牌号输入展示区 -->
  <view class="plate-input-area">
    <view class="plate-label">请输入车牌号</view>
    <view class="plate-slots">
      <view
        class="plate-slot {{index === currentIndex ? 'slot-active' : ''}} {{index < plateChars.length ? 'slot-filled' : ''}}"
        wx:for="{{[0,1,2,3,4,5,6,7]}}"
        wx:key="*this"
        wx:for-item="index"
      ><text>{{plateChars[index] || ''}}</text></view>
    </view>
    <view class="plate-hint" wx:if="{{plateChars.length === 0}}">点击下方键盘选择，最多8位</view>
    <view class="plate-hint" wx:elif="{{plateChars.length < 8}}">已输入{{plateChars.length}}位，还可输入{{8 - plateChars.length}}位</view>
    <view class="plate-hint full" wx:else>已输入8位，点击「确认查询」开始查询</view>
  </view>

  <!-- 键盘区域 -->
  <view class="keyboard-area">
    <!-- 步骤指示器 -->
    <view class="step-indicator">
      <view class="step-dot {{currentIndex === 0 ? 'step-active' : ''}} {{plateChars.length > 0 ? 'step-done' : ''}}">1</view>
      <view class="step-line {{plateChars.length >= 2 ? 'step-done' : ''}}"></view>
      <view class="step-dot {{currentIndex === 1 ? 'step-active' : ''}} {{plateChars.length >= 2 ? 'step-done' : ''}}">2</view>
      <view class="step-line {{plateChars.length >= 3 ? 'step-done' : ''}}"></view>
      <view class="step-dot {{plateChars.length >= 3 ? 'step-done' : ''}} {{plateChars.length >= 3 ? '' : 'step-next'}}">3+</view>
    </view>
    <!-- 省份 -->
    <view class="keyboard-section" wx:if="{{currentIndex === 0}}">
      <view class="section-title">选择省份</view>
      <view class="key-grid province-grid">
        <view class="key-btn key-province" wx:for="{{provinces}}" wx:key="*this" wx:for-item="item" bindtap="onProvince" data-v="{{item}}">{{item}}</view>
      </view>
    </view>
    <!-- 字母 -->
    <view class="keyboard-section" wx:elif="{{currentIndex === 1}}">
      <view class="section-title">选择字母</view>
      <view class="key-grid letter-grid">
        <view class="key-btn key-letter" wx:for="{{letters}}" wx:key="*this" wx:for-item="item" bindtap="onLetter" data-v="{{item}}">{{item}}</view>
      </view>
    </view>
    <!-- 数字/字母分两行 -->
    <view class="keyboard-section" wx:else>
      <view class="section-title">第 {{currentIndex + 1}} 位 — 数字或字母</view>
      <view class="number-row">
        <view class="key-btn key-number" wx:for="{{numbers}}" wx:key="*this" wx:for-item="n" bindtap="onMixed" data-v="{{n}}">{{n}}</view>
      </view>
      <view class="letter-row">
        <view class="key-btn key-letter-mix" wx:for="{{letters}}" wx:key="*this" wx:for-item="l" bindtap="onMixed" data-v="{{l}}">{{l}}</view>
      </view>
    </view>
    <!-- 操作按钮 -->
    <view class="action-row">
      <view class="action-btn action-back" bindtap="onDelete"><text>⌫ 退格</text></view>
      <view class="action-btn action-reset" bindtap="onClear"><text>清空</text></view>
    </view>
    <button class="confirm-btn" bindtap="onConfirm" loading="{{loading}}" disabled="{{plateChars.length === 0}}">确认查询</button>
  </view>

  <!-- 查询结果 — 完全明文 -->
  <view class="result-area" wx:if="{{queryResult}}">
    <view class="result-card">
      <view class="result-title">车辆全部信息</view>
      <view class="result-row" wx:if="{{queryResult.vehicleType}}"><text class="result-label">车辆类型</text><text class="result-value">{{queryResult.vehicleType}}</text></view>
      <view class="result-row"><text class="result-label">车牌号</text><text class="result-value plate-number">{{queryResult.plateNumber}}</text></view>
      <view class="result-row" wx:if="{{queryResult.ownerName}}"><text class="result-label">车主姓名</text><text class="result-value">{{queryResult.ownerName}}</text></view>
      <view class="result-row" wx:if="{{queryResult.ownerPhone}}"><text class="result-label">车主电话</text><text class="result-value phone-value">{{queryResult.ownerPhone}}</text></view>
      <view class="result-row" wx:if="{{queryResult.parkingFee}}"><text class="result-label">车位费</text><text class="result-value">{{queryResult.parkingFee}}</text></view>
      <view class="result-row" wx:if="{{queryResult.parkingSpot}}"><text class="result-label">车位编号</text><text class="result-value">{{queryResult.parkingSpot}}</text></view>
      <view class="result-row" wx:if="{{queryResult.startDate || queryResult.endDate}}"><text class="result-label">有效日期</text><text class="result-value">{{queryResult.startDate || '-'}} ~ {{queryResult.endDate || '-'}}</text></view>
      <view class="result-row" wx:if="{{queryResult.building || queryResult.unit || queryResult.room}}"><text class="result-label">栋单元房号</text><text class="result-value">{{queryResult.building || ''}}{{queryResult.unit ? '-' + queryResult.unit : ''}}{{queryResult.room ? '-' + queryResult.room : ''}}</text></view>
      <view class="result-row" wx:if="{{queryResult.remark}}"><text class="result-label">备注</text><text class="result-value">{{queryResult.remark}}</text></view>
      <button class="call-btn" bindtap="onCallOwner" wx:if="{{queryResult.ownerPhone}}">联系车主挪车 ☎</button>
    </view>
  </view>
</view>

.repair-container {
  padding: 30rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

.guest-mode-tip {
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #ad6800;
}

/* 选项卡样式 */
.tab-container {
  display: flex;
  background: white;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s;
  font-weight: 500;
}

.tab-item.active {
  background: linear-gradient(135deg, #1aad19, #4cd964);
  color: white;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(26, 173, 25, 0.3);
}

.content-section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 20rpx;
}

/* 页面头部 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 紧急开关样式 */
.urgency-switch {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.urgency-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.urgency-toggle {
  transform: scale(0.8);
}

.urgency-tag {
  font-size: 24rpx;
  color: #ff6b6b;
  background: #fff0f0;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 表单样式 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.form-label.required::after {
  content: "*";
  color: #ff6b6b;
  margin-left: 8rpx;
}

.picker {
  padding: 24rpx;
  background: #f8f9fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.picker.placeholder {
  color: #999;
}

.form-input {
  padding: 24rpx;
  background: #f8f9fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  background: #f8f9fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  min-height: 120rpx;
  line-height: 1.6;
}

.divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #e0e0e0, transparent);
  margin: 40rpx 0;
}

/* 上传区域 */
.upload-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 24rpx;
  display: block;
}

.image-uploader,
.video-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item,
.video-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.uploaded-video {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #e0e0e0;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f9fa;
  transition: all 0.3s;
}

.upload-btn:active {
  background: #f0f0f0;
}

.upload-icon {
  font-size: 48rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

/* 提交按钮 */
.submit-btn {
  background: linear-gradient(135deg, #1aad19, #4cd964);
  color: white;
  border: none;
  border-radius: 16rpx;
  padding: 14rpx;
  font-size: 32rpx;
  font-weight: bold;
  width: 100%;
  box-shadow: 0 8rpx 24rpx rgba(26, 173, 25, 0.3);
  transition: all 0.3s;
  margin: 40rpx 0;
}

.submit-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(26, 173, 25, 0.3);
}

.submit-btn:disabled {
  background: #ccc;
  box-shadow: none;
  transform: none;
}

/* 进度区域 */
.progress-section {
  margin-top: 40rpx;
}

.progress-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.progress-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 1rpx solid #e8e8e8;
}

.progress-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.progress-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.progress-time {
  font-size: 24rpx;
  color: #999;
}

.progress-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.progress-status.pending {
  background: #fff0e8;
  color: #ff7a45;
}

.progress-status.processing {
  background: #e8f5e8;
  color: #1aad19;
}

.progress-status.completed {
  background: #f0f0f0;
  color: #999;
}

.no-progress {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

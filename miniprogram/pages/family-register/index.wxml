<view class="register-container">

  <view class="form-container">
    <view class="form-item">
      <view class="label">
        <text class="required">*</text>
        <text>邀请码</text>
      </view>
      <input 
        class="input" 
        placeholder="请输入户主提供的邀请码" 
        value="{{formData.inviteCode}}"
        bindinput="onInputChange"
        data-field="inviteCode"
        maxlength="10"
      />
      <view class="hint">请向户主索要邀请码</view>
    </view>

    <view class="form-item">
      <view class="label">
        <text class="required">*</text>
        <text>姓名</text>
      </view>
      <input 
        class="input" 
        placeholder="请输入您的真实姓名" 
        value="{{formData.name}}"
        bindinput="onInputChange"
        data-field="name"
        maxlength="20"
      />
    </view>

    <view class="form-item">
      <view class="label">
        <text class="required">*</text>
        <text>手机号</text>
      </view>
      <input 
        class="input" 
        type="number"
        placeholder="请输入手机号" 
        value="{{formData.phone}}"
        bindinput="onInputChange"
        data-field="phone"
        maxlength="11"
      />
    </view>

    <view class="form-item">
      <view class="label">
        <text>与户主关系</text>
      </view>
      <picker 
        mode="selector" 
        range="{{relationOptions}}" 
        value="{{formData.relationIndex}}"
        bindchange="onRelationChange"
      >
        <view class="picker">
          {{formData.relation}}
        </view>
      </picker>
    </view>

    <view class="tips">
      <text class="tip-icon">ℹ️</text>
      <view class="tip-content">
        <view class="tip-text">• 邀请码由户主在"我的家属"中生成</view>
        <view class="tip-text">• 注册成功后，您将关联到户主的房产</view>
        <view class="tip-text">• 需要等待户主确认后才能正常使用功能</view>
      </view>
    </view>

    <button class="submit-btn" bindtap="handleSubmit" disabled="{{isSubmitting}}">
      {{isSubmitting ? '提交中...' : '提交注册'}}
    </button>
  </view>
</view>

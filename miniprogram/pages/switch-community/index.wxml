<view class="switch-community-page">
  <!-- 当前小区 -->
  <view class="current-section">
    <view class="section-title">当前小区</view>
    <view class="current-community" wx:if="{{currentCommunity}}">
      <image src="/images/icon-community.png" class="community-icon" mode="aspectFit"/>
      <view class="community-info">
        <text class="community-name">{{currentCommunity.communityName}}</text>
        <text class="community-address">{{currentCommunity.fullAddress}}</text>
      </view>
      <view class="current-badge">当前</view>
    </view>
    <view class="no-community" wx:else>
      <text class="no-data-text">暂无绑定小区</text>
    </view>
  </view>

  <!-- 其他已审核通过的小区 -->
  <view class="communities-section">
    <view class="section-title">其他小区</view>
    <view class="communities-list" wx:if="{{otherCommunities.length > 0}}">
      <view class="community-item" 
            wx:for="{{otherCommunities}}" 
            wx:key="_id"
            bindtap="switchCommunity"
            data-community-id="{{item.communityId}}"
            data-binding-id="{{item._id}}">
        <image src="/images/icon-community.png" class="community-icon" mode="aspectFit"/>
        <view class="community-info">
          <text class="community-name">{{item.communityName}}</text>
          <text class="community-address">{{item.fullAddress}}</text>
        </view>
        <text class="switch-arrow">></text>
      </view>
    </view>
    <view class="no-community" wx:else>
      <text class="no-data-text">暂无其他小区</text>
    </view>
  </view>

  <!-- 添加新小区按钮 -->
  <view class="add-section">
    <button class="add-btn" bindtap="addNewCommunity">
      <text class="add-icon">+</text>
      <text class="add-text">添加新小区</text>
    </button>
  </view>
</view>

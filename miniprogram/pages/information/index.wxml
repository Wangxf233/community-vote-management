<wxs module="utils">
var formatTime = function(publishTime) {
  if (!publishTime) return '';
  
  var now = getDate();
  var publish = getDate(publishTime);
  var diff = now.getTime() - publish.getTime();
  
  var minutes = Math.floor(diff / 60000);
  var hours = Math.floor(diff / 3600000);
  var days = Math.floor(diff / 86400000);
  
  if (minutes < 1) {
    return '刚刚';
  } else if (minutes < 60) {
    return minutes + '分钟前';
  } else if (hours < 24) {
    return hours + '小时前';
  } else if (days < 30) {
    return days + '天前';
  } else {
    var year = publish.getFullYear();
    var month = publish.getMonth() + 1;
    var day = publish.getDate();
    return year + '-' + (month < 10 ? '0' + month : month) + '-' + (day < 10 ? '0' + day : day);
  }
};

module.exports = {
  formatTime: formatTime
};
</wxs>

<view class="notification-page">
  <!-- 审核状态提示 -->
  <view class="status-tip pending" wx:if="{{bindingStatus === 'pending'}}">
    <text class="status-icon">⏳</text>
    <text class="status-text">您的认证申请正在审核中，请耐心等待</text>
  </view>
  <view class="status-tip rejected" wx:if="{{bindingStatus === 'rejected'}}">
    <text class="status-icon">⚠️</text>
    <text class="status-text">审核未通过，请重新提交认证申请</text>
  </view>

  <!-- 通知公告列表 -->
  <view class="notification-list">
    <view class="section-header">
      <text class="section-title">通知公告</text>
    </view>

    <view class="list-container">
      <view 
        class="notification-item" 
        wx:for="{{notificationList}}" 
        wx:key="_id"
        bindtap="goToDetail"
        data-id="{{item._id}}"
      >
        <view class="item-header">
          <view class="item-title">
            <text wx:if="{{item.isPinned}}" class="pin-badge">置顶</text>
            {{item.title}}
          </view>
          <text class="item-time">{{utils.formatTime(item.publishTime)}}</text>
        </view>
        <view class="item-content">{{item.content}}</view>
        <view class="item-footer">
          <text class="publisher">{{item.publisher}}</text>
          <text wx:if="{{item.attachments && item.attachments.length > 0}}" class="attachment-badge">
            📎 {{item.attachments.length}}个附件
          </text>
        </view>
      </view>

      <view wx:if="{{notificationList.length === 0}}" class="empty-tip">
        <text>暂无通知公告</text>
      </view>

      <view wx:if="{{!hasMore && notificationList.length > 0}}" class="no-more">
        <text>没有更多了</text>
      </view>
    </view>
  </view>
</view>

<guest-tip></guest-tip>

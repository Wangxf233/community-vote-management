.notification-page {
  padding: 16rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 审核状态提示 */
.status-tip {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.status-tip.pending {
  background: #fff3e0;
  border-left: 4rpx solid #ff9800;
}

.status-tip.rejected {
  background: #ffebee;
  border-left: 4rpx solid #f44336;
}

.status-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.status-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
}

/* 通知公告列表 */
.notification-list {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
}

.section-header {
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.list-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notification-item {
  padding: 24rpx;
  background: #fafafa;
  border-radius: 12rpx;
  border-left: 4rpx solid #1aad19;
  transition: all 0.3s;
}

.notification-item:active {
  background: #f0f0f0;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.item-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
  margin-right: 16rpx;
}

.pin-badge {
  display: inline-block;
  background: #ff4444;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
  font-weight: normal;
}

.item-time {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
}

.item-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 16rpx;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
}

.publisher {
  color: #1aad19;
  font-weight: 500;
}

.attachment-badge {
  color: #999;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 24rpx;
}

/* 信息分类 - 更紧凑 */
.info-category {
  margin-bottom: 24rpx;
}

.info-category:last-child {
  margin-bottom: 0;
}

.category-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 8rpx;
  padding-left: 8rpx;
  border-left: 4rpx solid #1a73e8;
}

/* 信息列表 - 更紧凑 */
.info-list {
  background: #fafafa;
  border-radius: 6rpx;
  overflow: hidden;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 24rpx;
  border-bottom: 1rpx solid #eee;
  background: white;
  min-height: 80rpx;
}

.info-item:active {
  background-color: #f8f9fa;
}

.info-item:last-child {
  border-bottom: none;
}

.info-title {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.4;
}

.info-time {
  font-size: 24rpx;
  color: #999;
  min-width: 120rpx;
  text-align: right;
}

.info-more {
  font-size: 24rpx;
  color: #1a73e8;
  min-width: 120rpx;
  text-align: right;
}

/* 法律法规特殊样式 */
.laws-item {
  padding: 10rpx 24rpx;
}

.laws-item .info-title {
  font-size: 28rpx;
  color: #333;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .information-page {
    padding: 12rpx;
  }

  .info-item {
    padding: 16rpx 20rpx;
    min-height: 72rpx;
  }

  .info-title {
    font-size: 26rpx;
  }

  .info-time,
  .info-more {
    font-size: 22rpx;
    min-width: 100rpx;
  }
}

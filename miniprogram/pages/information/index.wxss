.information-page {
  padding: 16rpx;
  background-color: #f5f5f5;
  height: 100vh;
  font-size: 28rpx;
  overflow: hidden;
  box-sizing: border-box;
}

/* 审核状态提示 */
.status-tip {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.status-tip.pending {
  background: #fff3e0;
  border-left: 4rpx solid #ff9800;
}

.status-tip.rejected {
  background: #ffebee;
  border-left: 4rpx solid #f44336;
}

.status-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.status-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
}

/* 新消息提示 - 更紧凑 */
.new-message-notice {
  display: flex;
  justify-content: space-between;
  align-items: center;
  /* background: linear-gradient(135deg, #1a73e8, #6c8ef5); */
  background: linear-gradient(135deg, #1aad19, #4cd964);
  color: white;
  padding: 20rpx 24rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 115, 232, 0.3);
}

.notice-content {
  display: flex;
  align-items: center;
}

.notice-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.notice-text {
  font-size: 28rpx;
  font-weight: 500;
}

.arrow {
  font-size: 32rpx;
  font-weight: bold;
}

/* 信息区块 - 更紧凑 */
.info-section {
  background: white;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.05);
}

/* 分类入口样式 */
.categories {
  display: flex;
  justify-content: space-between;
  /* 顶部对齐：保证图标在同一水平线上 */
  align-items: flex-start;
  padding: 20rpx 10rpx 10rpx 10rpx;
  gap: 20rpx;
}

.category-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  padding: 16rpx;
  border-radius: 10rpx;
  min-height: 140rpx;
  /* 允许子项缩小，避免长文本推高图标 */
  min-width: 0;
}

.category-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 12rpx;
}

.category-text {
  font-size: 28rpx;
  color: #333;
  text-align: center;
  /* 允许文本换行并限制最多两行显示 */
  white-space: normal;
  word-break: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 5rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #1a73e8;
  padding: 8rpx 16rpx;
}

/* 信息分类 - 更紧凑 */
.info-category {
  margin-bottom: 24rpx;
}

.info-category:last-child {
  margin-bottom: 0;
}

.category-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 8rpx;
  padding-left: 8rpx;
  border-left: 4rpx solid #1a73e8;
}

/* 信息列表 - 更紧凑 */
.info-list {
  background: #fafafa;
  border-radius: 6rpx;
  overflow: hidden;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 24rpx;
  border-bottom: 1rpx solid #eee;
  background: white;
  min-height: 80rpx;
}

.info-item:active {
  background-color: #f8f9fa;
}

.info-item:last-child {
  border-bottom: none;
}

.info-title {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.4;
}

.info-time {
  font-size: 24rpx;
  color: #999;
  min-width: 120rpx;
  text-align: right;
}

.info-more {
  font-size: 24rpx;
  color: #1a73e8;
  min-width: 120rpx;
  text-align: right;
}

/* 法律法规特殊样式 */
.laws-item {
  padding: 10rpx 24rpx;
}

.laws-item .info-title {
  font-size: 28rpx;
  color: #333;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .information-page {
    padding: 12rpx;
  }

  .info-item {
    padding: 16rpx 20rpx;
    min-height: 72rpx;
  }

  .info-title {
    font-size: 26rpx;
  }

  .info-time,
  .info-more {
    font-size: 22rpx;
    min-width: 100rpx;
  }
}

<view class="service-container">
  <!-- 广告轮播图 -->
  <swiper
    wx:if="{{adImages && adImages.length > 0}}"
    class="ad-swiper"
    autoplay="{{true}}"
    interval="3000"
    duration="500"
    circular="{{true}}"
    indicator-dots="{{true}}"
    indicator-color="rgba(255,255,255,0.6)"
    indicator-active-color="#ffffff"
  >
    <swiper-item wx:for="{{adImages}}" wx:key="index">
      <image class="ad-image" src="{{item}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>
  <!-- 无广告时显示默认 header -->
  <view class="header" wx:else>
    <text class="title">{{propertyName}}</text>
    <text class="subtitle">竭诚为您服务</text>
  </view>

  <!-- 审核状态提示 -->
  <view class="status-tip pending" wx:if="{{bindingStatus === 'pending'}}">
    <text class="status-icon">⏳</text>
    <text class="status-text">您的认证申请正在审核中，请耐心等待</text>
  </view>
  <view class="status-tip rejected" wx:if="{{bindingStatus === 'rejected'}}">
    <text class="status-icon">⚠️</text>
    <text class="status-text">审核未通过，请重新提交认证申请</text>
  </view>

  <view class="service-grid">
    <view class="service-item" bindtap="navigateToRepair">
      <view class="icon-wrapper repair-icon">
        <image src="cloud://cloud1-6ghienoi526fff51.636c-cloud1-6ghienoi526fff51-1325504194/images/repair.png" class="service-icon"></image>
      </view>
      <text class="service-text">报事报修</text>
    </view>

    <view class="service-item" bindtap="navigateToEvaluation">
      <view class="icon-wrapper evaluation-icon">
        <image src="cloud://cloud1-6ghienoi526fff51.636c-cloud1-6ghienoi526fff51-1325504194/images/evaluation.png" class="service-icon"></image>
      </view>
      <text class="service-text">服务评价</text>
    </view>

    <view class="service-item" bindtap="navigateToVote">
      <view class="icon-wrapper vote-icon">
        <image src="cloud://cloud1-6ghienoi526fff51.636c-cloud1-6ghienoi526fff51-1325504194/images/vote.png" class="service-icon"></image>
      </view>
      <text class="service-text">投票表决</text>
    </view>

    <view class="service-item" bindtap="navigateToSurvey">
      <view class="icon-wrapper survey-icon">
        <image src="cloud://cloud1-6ghienoi526fff51.636c-cloud1-6ghienoi526fff51-1325504194/images/survey.png" class="service-icon"></image>
      </view>
      <text class="service-text">问卷调查</text>
    </view>

    <view class="service-item" bindtap="navigateToInformation">
      <view class="icon-wrapper information-icon">
        <image src="cloud://cloud1-6ghienoi526fff51.636c-cloud1-6ghienoi526fff51-1325504194/images/info.png" class="service-icon"></image>
      </view>
      <text class="service-text">信息公示</text>
    </view>

    <view class="service-item" bindtap="navigateToLaws">
      <view class="icon-wrapper laws-icon">
        <image src="cloud://cloud1-6ghienoi526fff51.636c-cloud1-6ghienoi526fff51-1325504194/images/icon-laws.png" class="service-icon"></image>
      </view>
      <text class="service-text">法律法规</text>
    </view>

    <view class="service-item" bindtap="navigateToIndustryNews">
      <view class="icon-wrapper industry-icon">
        <image src="cloud://cloud1-6ghienoi526fff51.636c-cloud1-6ghienoi526fff51-1325504194/images/icon-industry.png" class="service-icon"></image>
      </view>
      <text class="service-text">行业动态</text>
    </view>

    <view class="service-item" bindtap="navigateToBasicInfo">
      <view class="icon-wrapper wiki-icon">
        <image src="cloud://cloud1-6ghienoi526fff51.636c-cloud1-6ghienoi526fff51-1325504194/images/icon-wiki.png" class="service-icon"></image>
      </view>
      <text class="service-text">小区百科</text>
    </view>
  </view>

</view>

<guest-tip></guest-tip>

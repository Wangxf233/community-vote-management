.service-container {
  height: 100vh;
  background: #f5f5f5;
  padding: 40rpx 30rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.header {
  position: relative;
  background: linear-gradient(135deg, #1aad19, #4cd964);
  text-align: center;
  margin: -40rpx -30rpx 40rpx;
  padding: 60rpx 30rpx 40rpx;
  border-radius: 0 0 30rpx 30rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 审核状态提示 */
.status-tip {
  margin: 20rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.status-tip.pending {
  background: #fff3e0;
  border-left: 4rpx solid #ff9800;
}

.status-tip.rejected {
  background: #ffebee;
  border-left: 4rpx solid #f44336;
}

.status-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.status-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
}

.service-grid {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  padding: 20rpx 0;
}

.service-item {
  width: 30%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 20rpx 30rpx;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
  transition: all 0.3s;
}

.service-item:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.15);
}

.icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vote-icon {
  background: transparent;
}

.survey-icon {
  background: transparent;
}

.evaluation-icon {
  background: transparent;
}

.repair-icon {
  background: transparent;
}

.information-icon {
  background: transparent;
}

.service-icon {
  width: 80rpx;
  height: 80rpx;
}

.service-text {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.service-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.guest-tip {
  position: absolute;
  top: 10rpx;
  left: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.12);
}

.tip-content {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: nowrap;
}

.tip-icon {
  font-size: 30rpx;
  margin-right: 6rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #666666;
}

.tip-link {
  font-size: 26rpx;
  color: #1aad19;
  font-weight: bold;
  margin: 0 6rpx;
}

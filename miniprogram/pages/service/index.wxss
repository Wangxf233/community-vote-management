.service-container {
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

/* 广告轮播 */
.ad-swiper {
  width: 100%;
  height: 300rpx;
  flex-shrink: 0;
  border-radius: 0 0 30rpx 30rpx;
  overflow: hidden;
}

.ad-image {
  width: 100%;
  height: 100%;
}

.header {
  flex-shrink: 0;
  background: linear-gradient(135deg, #1aad19, #4cd964);
  text-align: center;
  padding: 50rpx 30rpx 36rpx;
  border-radius: 0 0 30rpx 30rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 审核状态提示 */
.status-tip {
  margin: 20rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.status-tip.pending {
  background: #fff3e0;
  border-left: 4rpx solid #ff9800;
}

.status-tip.rejected {
  background: #ffebee;
  border-left: 4rpx solid #f44336;
}

.status-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.status-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
}

.service-grid {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: repeat(4, 1fr);
  gap: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.service-item {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.09);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.service-item:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vote-icon {
  background: transparent;
}

.survey-icon {
  background: transparent;
}

.evaluation-icon {
  background: transparent;
}

.repair-icon {
  background: transparent;
}

.information-icon {
  background: transparent;
}

.service-icon {
  width: 66rpx;
  height: 66rpx;
}

.service-text {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.service-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.guest-tip {
  position: absolute;
  top: 10rpx;
  left: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.12);
}

.tip-content {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: nowrap;
}

.tip-icon {
  font-size: 30rpx;
  margin-right: 6rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #666666;
}

.tip-link {
  font-size: 26rpx;
  color: #1aad19;
  font-weight: bold;
  margin: 0 6rpx;
}

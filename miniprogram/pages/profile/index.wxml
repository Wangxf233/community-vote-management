<view class="profile-page">
  <!-- 审核状态提示 -->
  <view class="status-tip pending" wx:if="{{bindingStatus === 'pending'}}">
    <text class="status-icon">⏳</text>
    <text class="status-text">您的认证申请正在审核中，请耐心等待</text>
  </view>
  <view class="status-tip rejected" wx:if="{{bindingStatus === 'rejected'}}">
    <text class="status-icon">⚠️</text>
    <text class="status-text">审核未通过，请重新提交认证申请</text>
  </view>

  <!-- 菜单列表 -->
  <view class="section">
    <view class="menu-list">
      <view class="menu-item" bindtap="goToBasicInfo">
        <view class="menu-left">
          <image src="/images/icon-community.png" mode="aspectFit" class="menu-icon"/>
          <text class="menu-text">小区基本情况</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToMyHouse">
        <view class="menu-left">
          <image src="/images/icon-home.png" mode="aspectFit" class="menu-icon"/>
          <text class="menu-text">我的房屋</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToMyFamily" wx:if="{{isOwner}}">
        <view class="menu-left">
          <image src="/images/icon-family.png" mode="aspectFit" class="menu-icon"/>
          <text class="menu-text">我的家属</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToMyVotes">
        <view class="menu-left">
          <image src="/images/icon-vote.png" mode="aspectFit" class="menu-icon"/>
          <text class="menu-text">我的投票</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToRepairProgress">
        <view class="menu-left">
          <image src="/images/icon-repair.png" mode="aspectFit" class="menu-icon"/>
          <text class="menu-text">我的报修</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToContact">
        <view class="menu-left">
          <image src="/images/icon-contact.png" mode="aspectFit" class="menu-icon"/>
          <text class="menu-text">联系开发者</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToSettings">
        <view class="menu-left">
          <image src="/images/changeCommunity.png" mode="aspectFit" class="menu-icon"/>
          <text class="menu-text">切换小区</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>
</view>
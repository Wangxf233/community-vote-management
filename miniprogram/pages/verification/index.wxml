<view class="verification-container">
  <view class="header">
    <text class="title">实名认证</text>
    <text class="subtitle">为保证投票的真实性，请完成实名认证</text>
  </view>

  <!-- 认证状态提示 -->
  <view class="status-tip" wx:if="{{verificationStatus}}">
    <view class="status-box {{verificationStatus}}">
      <text class="status-icon" wx:if="{{verificationStatus === 'pending'}}">⏱</text>
      <text class="status-icon" wx:if="{{verificationStatus === 'approved'}}">✓</text>
      <text class="status-icon" wx:if="{{verificationStatus === 'rejected'}}">✗</text>
      <text class="status-icon" wx:if="{{verificationStatus === 'unverified'}}">ℹ</text>
      
      <view class="status-content">
        <text class="status-title">{{statusText}}</text>
        <text class="status-desc" wx:if="{{verificationStatus === 'pending'}}">您的认证资料正在审核中，请耐心等待</text>
        <text class="status-desc" wx:if="{{verificationStatus === 'approved'}}">您已完成实名认证，可以参与投票</text>
        <text class="status-desc" wx:if="{{verificationStatus === 'rejected'}}">{{rejectReason}}</text>
        <text class="status-desc" wx:if="{{verificationStatus === 'unverified'}}">请上传身份证和不动产证明完成实名认证</text>
      </view>
    </view>
  </view>

  <!-- 认证表单 -->
  <view class="form-container" wx:if="{{!verificationStatus || verificationStatus === 'rejected' || verificationStatus === 'unverified'}}">
    <!-- 身份证上传 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">身份证信息</text>
        <text class="required">*</text>
      </view>
      
      <view class="upload-group">
        <view class="upload-item">
          <text class="upload-label">身份证人像面</text>
          <view class="upload-box" bindtap="uploadIdCardFront">
            <image wx:if="{{idCardFront}}" src="{{idCardFront}}" class="preview-image" mode="aspectFill"></image>
            <view wx:else class="upload-placeholder">
              <text class="upload-icon">+</text>
              <text class="upload-text">点击上传</text>
            </view>
          </view>
        </view>

        <view class="upload-item">
          <text class="upload-label">身份证国徽面</text>
          <view class="upload-box" bindtap="uploadIdCardBack">
            <image wx:if="{{idCardBack}}" src="{{idCardBack}}" class="preview-image" mode="aspectFill"></image>
            <view wx:else class="upload-placeholder">
              <text class="upload-icon">+</text>
              <text class="upload-text">点击上传</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 房产证明上传 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">房产证明</text>
        <text class="required">*</text>
        <text class="tip">（以下三选一）</text>
      </view>

      <view class="cert-options">
        <view class="cert-option {{certType === 'property' ? 'selected' : ''}}" bindtap="selectCertType" data-type="property">
          <view class="option-header">
            <view class="radio">
              <text class="radio-dot" wx:if="{{certType === 'property'}}"></text>
            </view>
            <text class="option-title">不动产证</text>
          </view>
          <view class="upload-box small" wx:if="{{certType === 'property'}}" bindtap="uploadPropertyCert">
            <image wx:if="{{propertyCert}}" src="{{propertyCert}}" class="preview-image" mode="aspectFill"></image>
            <view wx:else class="upload-placeholder">
              <text class="upload-icon small">+</text>
              <text class="upload-text small">上传不动产证</text>
            </view>
          </view>
        </view>

        <view class="cert-option {{certType === 'contract' ? 'selected' : ''}}" bindtap="selectCertType" data-type="contract">
          <view class="option-header">
            <view class="radio">
              <text class="radio-dot" wx:if="{{certType === 'contract'}}"></text>
            </view>
            <text class="option-title">购房合同</text>
          </view>
          <view class="upload-box small" wx:if="{{certType === 'contract'}}" bindtap="uploadContract">
            <image wx:if="{{contract}}" src="{{contract}}" class="preview-image" mode="aspectFill"></image>
            <view wx:else class="upload-placeholder">
              <text class="upload-icon small">+</text>
              <text class="upload-text small">上传购房合同</text>
            </view>
          </view>
        </view>

        <view class="cert-option {{certType === 'payment' ? 'selected' : ''}}" bindtap="selectCertType" data-type="payment">
          <view class="option-header">
            <view class="radio">
              <text class="radio-dot" wx:if="{{certType === 'payment'}}"></text>
            </view>
            <text class="option-title">购买发票或收据</text>
          </view>
          <view class="upload-box small" wx:if="{{certType === 'payment'}}" bindtap="uploadPayment">
            <image wx:if="{{payment}}" src="{{payment}}" class="preview-image" mode="aspectFill"></image>
            <view wx:else class="upload-placeholder">
              <text class="upload-icon small">+</text>
              <text class="upload-text small">上传购买发票或收据</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 提示信息 -->
    <view class="tips">
      <text class="tips-title">温馨提示：</text>
      <text class="tips-item">1. 请确保照片清晰完整，信息可见</text>
      <text class="tips-item">2. 支持jpg、png格式图片</text>
      <text class="tips-item">3. 提交后将进入人工审核，请耐心等待</text>
      <text class="tips-item">4. 审核结果将通过消息通知</text>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-container">
      <button class="submit-btn" bindtap="submitVerification" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交认证'}}
      </button>
    </view>
  </view>

  <!-- 已认证状态的按钮 -->
  <view class="action-container" wx:if="{{verificationStatus === 'approved'}}">
    <button class="action-btn" bindtap="goBack">返回</button>
  </view>
</view>

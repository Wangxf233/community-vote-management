.verification-container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);
  padding: 40rpx 32rpx;
}

.header {
  text-align: center;
  margin-bottom: 48rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
}

/* 认证状态提示 */
.status-tip {
  margin-bottom: 32rpx;
}

.status-box {
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  border: 2rpx solid;
}

.status-box.pending {
  background: linear-gradient(135deg, #fff8e1 0%, #ffffff 100%);
  border-color: #ff9800;
}

.status-box.approved {
  background: linear-gradient(135deg, #e8f5e8 0%, #ffffff 100%);
  border-color: #07c160;
}

.status-box.rejected {
  background: linear-gradient(135deg, #ffebee 0%, #ffffff 100%);
  border-color: #ff4757;
}

.status-box.unverified {
  background: linear-gradient(135deg, #e3f2fd 0%, #ffffff 100%);
  border-color: #2196f3;
}

.status-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  font-weight: bold;
}

.status-box.pending .status-icon {
  color: #ff9800;
}

.status-box.approved .status-icon {
  color: #07c160;
}

.status-box.rejected .status-icon {
  color: #ff4757;
}

.status-box.unverified .status-icon {
  color: #2196f3;
}

.status-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.status-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.status-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 表单容器 */
.form-container {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.required {
  color: #ff4757;
  font-size: 32rpx;
  margin-left: 8rpx;
}

.tip {
  font-size: 24rpx;
  color: #999;
  margin-left: 12rpx;
}

/* 身份证上传 */
.upload-group {
  display: flex;
  gap: 24rpx;
}

.upload-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.upload-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.upload-box {
  width: 100%;
  height: 320rpx;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.upload-box.small {
  height: 240rpx;
  margin-top: 20rpx;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f9fa;
}

.upload-icon {
  font-size: 72rpx;
  color: #ccc;
  margin-bottom: 16rpx;
}

.upload-icon.small {
  font-size: 56rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
}

.upload-text.small {
  font-size: 24rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
}

/* 房产证明选项 */
.cert-options {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.cert-option {
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  padding: 24rpx;
  transition: all 0.3s;
}

.cert-option.selected {
  border-color: #07c160;
  background: #f8fff8;
}

.option-header {
  display: flex;
  align-items: center;
}

.radio {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.cert-option.selected .radio {
  border-color: #07c160;
  background: #07c160;
}

.radio-dot {
  width: 16rpx;
  height: 16rpx;
  background: white;
  border-radius: 50%;
}

.option-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 提示信息 */
.tips {
  background: #fff9e6;
  border: 1rpx solid #ffe58f;
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #d48806;
  margin-bottom: 8rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #8c6e00;
  line-height: 1.6;
}

/* 提交按钮 */
.submit-container {
  margin-top: 20rpx;
}

.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, #07c160, #4cd964);
  color: white;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.submit-btn:disabled {
  background: #ccc;
  box-shadow: none;
}

/* 操作按钮 */
.action-container {
  margin-top: 40rpx;
}

.action-btn {
  width: 100%;
  background: white;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: bold;
}

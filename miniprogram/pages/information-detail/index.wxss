.detail-page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  font-size: 28rpx;
  color: #999;
}

.detail-content {
  background: white;
}

/* 标题区域 */
.detail-header {
  padding: 40rpx 32rpx 30rpx;
  background: white;
}

.detail-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}

/* 元信息 */
.detail-meta {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fafafa;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.meta-item {
  display: flex;
  align-items: center;
}

.meta-label {
  font-size: 26rpx;
  color: #999;
}

.meta-value {
  font-size: 26rpx;
  color: #666;
}

.meta-divider {
  width: 2rpx;
  height: 24rpx;
  background: #ddd;
  margin: 0 20rpx;
}

/* 内容区域 */
.detail-body {
  padding: 40rpx 32rpx;
  background: white;
}

.detail-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 附件区域 */
.attachments-section {
  margin-top: 20rpx;
  padding: 32rpx;
  background: white;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.title-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.title-count {
  font-size: 26rpx;
  color: #999;
  margin-left: 4rpx;
}

.attachment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 图片附件 */
.attachment-item {
  display: flex;
  flex-direction: column;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fafafa;
}

.attachment-image {
  width: 100%;
  height: 400rpx;
  background: #f0f0f0;
}

.attachment-label {
  padding: 16rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  background: #fafafa;
}

/* 文档附件 */
.doc-item {
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.doc-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.doc-info {
  flex: 1;
  overflow: hidden;
}

.doc-name {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.download-icon {
  font-size: 26rpx;
  color: #1989fa;
  padding: 8rpx 20rpx;
  background: #e8f4ff;
  border-radius: 6rpx;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

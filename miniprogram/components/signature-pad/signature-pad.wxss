.signature-container {
  width: 100%;
}

/* 签名触发区域 */
.signature-trigger {
  position: relative;
  min-height: 200rpx;
  border: 2rpx dashed #d0d0d0;
  border-radius: 16rpx;
  background: #fafafa;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.trigger-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.trigger-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.trigger-text {
  font-size: 28rpx;
  color: #666;
}

.signature-preview {
  width: 100%;
  height: 200rpx;
}

.re-sign-btn {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  font-size: 24rpx;
  color: #1989fa;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
  border: 1rpx solid #1989fa;
}

/* 全屏签名弹窗 */
.signature-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.signature-modal.show {
  transform: translateY(0);
}

/* 横屏时使用固定 px 大小，避免 rpx 放大导致按钮/提示过大 */
.signature-modal.landscape .modal-header {
  padding: 8px 12px;
  height: 44px;
}
.signature-modal.landscape .modal-title {
  font-size: 16px;
}
.signature-modal.landscape .modal-actions {
  gap: 8px;
}
.signature-modal.landscape .action-btn {
  font-size: 16px;
  padding: 6px 12px;
  border-radius: 6px;
}

/* 减少 header 占用，放大画布显示区域 */
.signature-modal.landscape .canvas-wrapper {
  padding: 8px;
}
.signature-modal.landscape .signature-canvas {
  border-width: 1px;
  border-radius: 6px;
}

/* 小提示、触发区在横屏也减小文字 */
.signature-modal.landscape .modal-tip,
.signature-modal.landscape .trigger-text {
  font-size: 12px;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
  background: #fff;
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  font-size: 36rpx;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
}

.clear-btn {
  color: #ff4757;
  background: rgba(255, 71, 87, 0.1);
}

.cancel-btn {
  color: #666;
  background: #f5f5f5;
}

.confirm-btn {
  color: #fff;
  background: #07c160;
}

.canvas-wrapper {
  flex: 1;
  background: #fafafa;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 8rpx;
}

.signature-canvas {
  width: 100%;
  height: 100%;
  background: #fff;
  touch-action: none;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
}

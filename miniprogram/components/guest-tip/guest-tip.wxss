.guest-tip {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 24rpx;
  background: #fff8ef;
  border: 1rpx solid #ffd9a8;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  z-index: 1000;
  transform: translateY(120%);
  transition: transform 0.3s ease;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.12);
}

.guest-tip.show {
  transform: translateY(0);
}

.tip-content {
  display: flex;
  align-items: center;
  width: 100%;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #8a4d00;
  line-height: 1.4;
  padding-right: 12rpx;
}

.tip-action {
  background: #ff8a00;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

.tip-link {
  font-size: 24rpx;
  color: white;
  font-weight: 600;
}

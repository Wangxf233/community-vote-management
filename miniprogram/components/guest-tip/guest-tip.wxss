.guest-tip {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  z-index: 1000;
  transform: translateY(-100%);
  transition: transform 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.guest-tip.show {
  transform: translateY(0);
}

.tip-content {
  display: flex;
  align-items: center;
  width: 100%;
}

.tip-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: white;
  line-height: 1.4;
}

.tip-action {
  margin-left: 16rpx;
}

.tip-link {
  font-size: 26rpx;
  color: white;
  font-weight: bold;
  text-decoration: underline;
}

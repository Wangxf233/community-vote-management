/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

/* 通用样式 */
.page-container {
  padding: 30rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 20rpx 0;
  color: #333;
}

.divider {
  height: 1rpx;
  background-color: #eee;
  margin: 30rpx 0;
}

/* 按钮样式 */
.submit-btn {
  background-color: #1AAD19;
  color: white;
  border: none;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-top: 40rpx;
}

.submit-btn:disabled {
  background-color: #ccc;
}

/* 安全区域适配 */
page {
  --status-bar-height: 0px;
}

/* 确保所有容器正确显示 */
.container {
  box-sizing: border-box;
}

/* 修复滚动条问题 */
scroll-view {
  box-sizing: border-box;
}
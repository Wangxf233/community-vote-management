{
  "_scope": "admin-frontend 前端静态网站托管部署（权威）。admin 后端云托管部署配置见 admin/cloudbaserc.json",
  "envId": "cloud1-6ghienoi526fff51",
  "version": "2.0",
  "framework": {
    "name": "vue",
    "plugins": {
      "client": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "buildCommand": "cd admin-frontend && npm install && npm run build",
          "outputPath": "admin-frontend/dist",
          "cloudPath": "/",
          "envVariables": {
            "NODE_ENV": "production"
          }
        }
      }
    }
  }
}

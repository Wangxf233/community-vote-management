TCB_ENV_ID=your-cloudbase-envid
TCB_SECRET_ID=your-secret-id
TCB_SECRET_KEY=your-secret-key

# 服务监听端口
PORT=3000

# 云函数调用 admin 的密钥（强随机）
DOOR_CLOUD_ACCESS_KEY=replace-with-strong-random-key

# Fondcard API（厂商二次开发文档2.6：http://web.fondcard.net/open/mqtt/api.php?method=xxxx）
FONDCARD_API_BASE_URL=http://web.fondcard.net/open/mqtt/api.php
FONDCARD_API_TIMEOUT_MS=12000

# 纯 HTTP 开门执行（按设备或全局配置 method）
# 示例 method 需要替换为厂商最终确认的“开门执行”方法名
FONDCARD_OPEN_METHOD=mqtt.door.open
FONDCARD_OPEN_PLATFORM=
FONDCARD_OPEN_LOGIN_ID=

# 厂商固定参数（全局默认值，FondcardClient 优先读构造函数参数 > 环境变量 > 代码默认值）
FONDCARD_DEFAULT_PLATFORM=antai
FONDCARD_DEFAULT_LOGIN_ID=11609

# ===== 限流配置 =====
# 全局 API 限流（默认 60 秒窗口 100 次/IP；门禁 open-from-cloud 不占全局额度）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# 门禁开门接口单独限流（默认 60 秒 600 次/IP）
DOOR_RATE_LIMIT_WINDOW_MS=60000
DOOR_RATE_LIMIT_MAX=600

# trust proxy：云托管网关注入 X-Forwarded-For，默认开启（=1）；本地调试无代理也兼容；传 0 关闭
TRUST_PROXY=1

# ===== 压测/联调专用（生产勿设置）=====
# FONDCARD_MOCK_MODE=1 时不真实调用厂商接口，直接返回成功（压测门禁链路用）
FONDCARD_MOCK_MODE=

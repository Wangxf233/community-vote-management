TCB_ENV_ID=your-cloudbase-envid
TCB_SECRET_ID=your-secret-id
TCB_SECRET_KEY=your-secret-key

# 服务监听端口
PORT=3000

# 云函数调用 admin 的密钥（强随机）
DOOR_CLOUD_ACCESS_KEY=replace-with-strong-random-key

# admin 调用本机 gateway 的地址和密钥
DOOR_GATEWAY_URL=http://127.0.0.1:9101
DOOR_GATEWAY_KEY=replace-with-strong-random-key
DOOR_GATEWAY_TIMEOUT_MS=12000

# gateway 监听配置
DOOR_GATEWAY_HOST=127.0.0.1
DOOR_GATEWAY_PORT=9101

# Fondcard API
FONDCARD_API_BASE_URL=https://api.fondcard.example/open/api.php
FONDCARD_API_TIMEOUT_MS=12000

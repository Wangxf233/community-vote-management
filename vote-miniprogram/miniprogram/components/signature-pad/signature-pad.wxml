<view class="signature-container">
  <!-- 签名预览/触发区域 -->
  <view class="signature-trigger" bindtap="openSignature">
    <view class="trigger-content" wx:if="{{!signatureImage}}">
      <text class="trigger-icon">✍️</text>
      <text class="trigger-text">点击进行手写签名</text>
    </view>
    <image wx:else class="signature-preview" src="{{signatureImage}}" mode="aspectFit" />
    <text wx:if="{{signatureImage}}" class="re-sign-btn" catchtap="openSignature">重新签名</text>
  </view>

  <!-- 全屏签名弹窗 -->
  <view class="signature-modal {{showModal ? 'show' : ''}} {{isLandscapeMode ? 'landscape' : ''}}" catchtouchmove="preventMove">
    <view class="modal-header">
      <text class="modal-title">手写签名（请横屏签名）</text>
      <view class="modal-actions">
        <text class="action-btn clear-btn" bindtap="clearSignature">清空</text>
        <text class="action-btn cancel-btn" bindtap="closeModal">取消</text>
        <text class="action-btn confirm-btn" bindtap="confirmSignature">完成</text>
      </view>
    </view>
    <view class="canvas-wrapper">
      <canvas 
        type="2d"
        class="signature-canvas" 
        canvas-id="signatureCanvas"
        id="signatureCanvas"
        disable-scroll="{{true}}"
        bindtouchstart="touchStart"
        bindtouchmove="touchMove"
        bindtouchend="touchEnd">
      </canvas>
    </view>
  </view>
</view>

.information-categories-page {
  padding: 16rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 审核状态提示 */
.status-tip {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.status-tip.pending {
  background: #fff3e0;
  border-left: 4rpx solid #ff9800;
}

.status-tip.rejected {
  background: #ffebee;
  border-left: 4rpx solid #f44336;
}

.status-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.status-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
}

/* 信息区块 */
.info-section {
  background: white;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.05);
}

/* 分类入口样式 */
.categories {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 10rpx 10rpx 10rpx;
  gap: 20rpx;
}

.category-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  padding: 16rpx;
  border-radius: 10rpx;
  min-height: 140rpx;
  min-width: 0;
  transition: all 0.3s;
}

.category-item:active {
  background: #f5f5f5;
}

.category-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 12rpx;
}

.category-text {
  font-size: 28rpx;
  color: #333;
  text-align: center;
  white-space: normal;
  word-break: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 5rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

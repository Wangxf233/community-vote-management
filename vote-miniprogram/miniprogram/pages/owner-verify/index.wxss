.owner-verify-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.progress-bar {
  background: #fff;
  padding: 40rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.step-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  transition: all 0.3s;
}

.progress-step.active .step-circle {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.step-label {
  font-size: 22rpx;
  color: #999;
}

.progress-step.active .step-label {
  color: #333;
  font-weight: bold;
}

.progress-line {
  flex: 1;
  height: 4rpx;
  background: #e0e0e0;
  margin: 0 8rpx;
  margin-bottom: 32rpx;
  transition: all 0.3s;
}

.progress-line.active {
  background: linear-gradient(to right, #667eea, #764ba2);
}

.step-content {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  min-height: 500rpx;
}

.step-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.step-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.step-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.step-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.info-display {
  margin-bottom: 48rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.proof-types {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.proof-type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.proof-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.proof-name {
  font-size: 22rpx;
  color: #666;
}

.house-info {
  background: linear-gradient(135deg, #667eea15, #764ba215);
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
}

.house-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.house-value {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.upload-area {
  margin-bottom: 32rpx;
}

.image-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.image-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}

.upload-btn {
  aspect-ratio: 1;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.upload-icon {
  font-size: 48rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 22rpx;
  color: #999;
}

.upload-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

.action-area {
  display: flex;
  gap: 16rpx;
}

.primary-btn {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.primary-btn[disabled] {
  background: #e0e0e0;
  color: #999;
}

.secondary-btn {
  flex: 1;
  height: 88rpx;
  background: #fff;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.success-content {
  text-align: center;
}

.success-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.success-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.success-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.status-card {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 48rpx;
}

.status-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
}

.status-item:last-child {
  border-bottom: none;
}

.status-label {
  font-size: 26rpx;
  color: #666;
}

.status-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  max-width: 60%;
}

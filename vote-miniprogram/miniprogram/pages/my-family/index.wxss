.family-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

.invite-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

.card-content {
  padding-top: 20rpx;
}

.invite-code-display {
  margin-bottom: 20rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.code-box {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 10rpx;
}

.code {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #1aad19;
  letter-spacing: 4rpx;
}

.copy-btn {
  background: #1aad19;
  color: #fff;
  border: none;
  flex-shrink: 0;
}

.share-btn {
  background: #ff9500;
  color: #fff;
  border: none;
  flex-shrink: 0;
}

.expires-text {
  font-size: 24rpx;
  color: #999;
}

.generate-btn {
  width: 100%;
  background: linear-gradient(135deg, #1aad19 0%, #4cd964 100%);
  color: #fff;
  font-size: 30rpx;
  border-radius: 50rpx;
  padding: 24rpx 0;
  border: none;
}

.generate-btn::after {
  border: none;
}

.generate-btn[disabled] {
  background: #ccc;
  opacity: 0.6;
}

.family-list {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.count {
  font-size: 26rpx;
  color: #999;
}

.loading {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.list-items {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.family-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.family-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 2rpx solid #e4e7ed;
}

.avatar-icon {
  font-size: 36rpx;
}

.info {
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.relation {
  font-size: 24rpx;
  color: #999;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.phone-info {
  display: flex;
  align-items: center;
}

.phone {
  font-size: 26rpx;
  color: #666;
}

.remove-btn {
  background: #fff;
  color: #ff4444;
  border: 1rpx solid #ff4444;
  border-radius: 32rpx;
  font-size: 24rpx;
  padding: 4rpx 20rpx;
  height: auto;
  line-height: normal;
}

.family-actions {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.unbind-btn {
  width: 120rpx;
  height: 64rpx;
  background: #fff;
  color: #f5576c;
  border: 1rpx solid #f5576c;
  border-radius: 32rpx;
  font-size: 26rpx;
  line-height: 64rpx;
  padding: 0;
}

.rejected-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rejected-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  opacity: 0.7;
}

.rejected-info .name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.rejected-info .relationship {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.rejected-info .time {
  display: block;
  font-size: 22rpx;
  color: #999;
}

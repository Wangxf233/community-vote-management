<view class="basic-info-page">
  <!-- 头部 -->
  <view class="page-header">
    <text class="page-title">{{communityName}}</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误提示 -->
  <view wx:elif="{{error}}" class="error-container">
    <text class="error-text">{{error}}</text>
  </view>

  <!-- 内容区域 -->
  <view wx:elif="{{communityInfo}}" class="content">
    <!-- 基本信息表格 -->
    <view class="info-table">
      <view class="table-row">
        <text class="table-label">楼栋数量</text>
        <text class="table-value">{{communityInfo.buildingCount}}栋</text>
      </view>
      <view class="table-row">
        <text class="table-label">单元数量</text>
        <text class="table-value">{{communityInfo.unitCount}}个</text>
      </view>
      <view class="table-row">
        <text class="table-label">住宅数量</text>
        <text class="table-value">{{communityInfo.residentialCount}}户</text>
      </view>
      <view class="table-row">
        <text class="table-label">商铺数量</text>
        <text class="table-value">{{communityInfo.shopCount}}户</text>
      </view>
      <view class="table-row">
        <text class="table-label">业主数量</text>
        <text class="table-value">{{communityInfo.ownerCount}}人</text>
      </view>
      <view class="table-row">
        <text class="table-label">占地面积</text>
        <text class="table-value">{{communityInfo.landArea}}㎡</text>
      </view>
      
      <!-- 小区平面图 -->
      <view class="table-row clickable" wx:if="{{communityInfo.planImage}}" bindtap="previewPlanImage">
        <text class="table-label">小区平面图</text>
        <text class="table-value link-text">点击预览 ></text>
      </view>
      
      <!-- 小区效果图 -->
      <view class="table-row clickable" wx:if="{{communityInfo.effectImage}}" bindtap="previewEffectImage">
        <text class="table-label">小区效果图</text>
        <text class="table-value link-text">点击预览 ></text>
      </view>
      
      <!-- 建筑面积 -->
      <view class="table-row nested">
        <text class="table-label">建筑面积</text>
        <view class="nested-content">
          <view class="nested-row">
            <text class="nested-label">住宅面积</text>
            <text class="nested-value">{{communityInfo.buildingArea.residential}}㎡</text>
          </view>
          <view class="nested-row">
            <text class="nested-label">商户面积</text>
            <text class="nested-value">{{communityInfo.buildingArea.commercial}}㎡</text>
          </view>
        </view>
      </view>
      
      <!-- 专有面积 -->
      <view class="table-row nested">
        <text class="table-label">专有面积</text>
        <view class="nested-content">
          <view class="nested-row">
            <text class="nested-label">住宅面积</text>
            <text class="nested-value">{{communityInfo.exclusiveArea.residential}}㎡</text>
          </view>
          <view class="nested-row">
            <text class="nested-label">商户面积</text>
            <text class="nested-value">{{communityInfo.exclusiveArea.commercial}}㎡</text>
          </view>
        </view>
      </view>
      
      <view class="table-row">
        <text class="table-label">地下车库面积</text>
        <text class="table-value">{{communityInfo.undergroundParkingArea}}㎡</text>
      </view>
      <view class="table-row">
        <text class="table-label">地面车位数量</text>
        <text class="table-value">{{communityInfo.surfaceParkingCount}}个</text>
      </view>
      <view class="table-row">
        <text class="table-label">地下车位数量</text>
        <text class="table-value">{{communityInfo.undergroundParkingCount}}个</text>
      </view>
      <view class="table-row">
        <text class="table-label">车辆数量</text>
        <text class="table-value">{{communityInfo.vehicleCount}}辆</text>
      </view>
    </view>
  </view>
</view>
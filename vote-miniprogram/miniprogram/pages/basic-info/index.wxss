.basic-info-page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.page-header {
  background: white;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

/* 加载和错误状态 */
.loading-container,
.error-container {
  padding: 80rpx 30rpx;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.error-text {
  font-size: 28rpx;
  color: #f56c6c;
}

/* 小区图片区域 */
.images-section {
  margin-bottom: 20rpx;
}

.image-item {
  background: white;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.image-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 15rpx;
}

.community-image {
  width: 100%;
  height: 400rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}

/* 信息表格 */
.info-table {
  background: white;
  border-radius: 12rpx;
  overflow: hidden;
}

.table-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row:last-child {
  border-bottom: none;
}

.table-label {
  font-size: 30rpx;
  color: #666;
  flex: 1;
}

.table-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  flex: 1;
}

/* 可点击行样式 */
.table-row.clickable {
  background-color: #fff;
  transition: background-color 0.2s;
}

.table-row.clickable:active {
  background-color: #f5f5f5;
}

.link-text {
  color: #1989fa;
  font-size: 28rpx;
}

/* 嵌套行样式 */
.table-row.nested {
  flex-direction: column;
  align-items: stretch;
  padding: 0;
}

.table-row.nested .table-label {
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f8f8f8;
}

.nested-content {
  width: 100%;
}

.nested-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f8f8f8;
}

.nested-row:last-child {
  border-bottom: 1rpx solid #f0f0f0;
}

.nested-label {
  font-size: 28rpx;
  color: #888;
  flex: 1;
  padding-left: 40rpx;
}

.nested-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  flex: 1;
}

<view class="list-page">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">{{pageTitle}}</text>
  </view>

  <!-- 信息列表 -->
  <view class="list-container">
    <block wx:for="{{informationList}}" wx:key="_id">
      <view class="list-item {{item.isPinned ? 'pinned' : ''}}" data-id="{{item._id}}" bindtap="goToDetail">
        <!-- 标题行 -->
        <view class="item-header">
          <text class="pin-icon" wx:if="{{item.isPinned}}">置顶</text>
          <text class="item-title">{{item.title}}</text>
          <view class="unread-dot" wx:if="{{!item.isRead}}"></view>
        </view>
        
        <!-- 内容摘要 -->
        <view class="item-content" wx:if="{{item.content}}">
          <text class="content-text">{{item.content}}</text>
        </view>
        
        <!-- 底部信息 -->
        <view class="item-footer">
          <text class="item-time">{{item.displayTime}}</text>
          <text class="item-publisher" wx:if="{{item.publisher}}">{{item.publisher}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 加载提示 -->
  <view class="loading-tip" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && informationList.length === 0}}">
    <text class="empty-text">暂无信息</text>
  </view>
</view>

.switch-community-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

/* 当前小区样式 */
.current-section {
  margin-bottom: 30rpx;
}

.current-community {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid #07c160;
}

.community-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.community-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.community-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.community-address {
  font-size: 24rpx;
  color: #999;
}

.current-badge {
  background-color: #07c160;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 其他小区列表样式 */
.communities-section {
  margin-bottom: 30rpx;
}

.communities-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.community-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.community-item:active {
  background-color: #f8f8f8;
  transform: scale(0.98);
}

.switch-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 10rpx;
}

/* 无数据样式 */
.no-community {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 80rpx 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.no-data-text {
  font-size: 28rpx;
  color: #999;
}

/* 添加新小区按钮 */
.add-section {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.add-btn {
  background: linear-gradient(135deg, #07c160 0%, #05a952 100%);
  color: #fff;
  border-radius: 16rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

.add-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.add-icon {
  font-size: 40rpx;
  margin-right: 10rpx;
  font-weight: normal;
}

.add-text {
  font-size: 32rpx;
}

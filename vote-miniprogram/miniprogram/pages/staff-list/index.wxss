.staff-list-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  box-sizing: border-box;
  margin-top: 35rpx;
}

/* 状态栏占位 */
.status-bar {
  width: 100%;
  background: white;
}

/* 顶部搜索栏 */
.search-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left, .header-right {
  width: 120rpx;
  display: flex;
  align-items: center;
}

.header-center {
  flex: 1;
  text-align: center;
}

.cancel-btn {
  font-size: 30rpx;
  color: #666;
  padding: 16rpx 0;
}

.confirm-btn {
  font-size: 30rpx;
  color: #ccc;
  padding: 16rpx 0;
  font-weight: 500;
}

.confirm-btn.active {
  color: #1AAD19;
  font-weight: bold;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

/* 搜索框 */
.search-box {
  padding: 30rpx;
  background: white;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-input-container {
  position: relative;
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e8e8e8;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: transparent;
}

.search-input::placeholder {
  color: #999;
}

.clear-btn {
  font-size: 36rpx;
  color: #999;
  width: 40rpx;
  height: 40rpx;
  text-align: center;
  line-height: 36rpx;
  background: #e0e0e0;
  border-radius: 50%;
}

/* 人员列表 */
.staff-list {
  height: calc(100vh - 240rpx);
  background-color: #f5f5f5;
}

.list-content {
  padding: 0 30rpx;
  box-sizing: border-box;
}

.staff-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: white;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.staff-item.selected {
  background: #f8fff8;
  border-color: #1AAD19;
  box-shadow: 0 6rpx 20rpx rgba(26, 173, 25, 0.15);
}

.staff-item:active {
  transform: scale(0.98);
}

.staff-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #f0f0f0;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.staff-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.staff-basic {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.staff-name {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.staff-position {
  font-size: 26rpx;
  color: #666;
  background: #f0f0f0;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.staff-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.4;
  word-break: break-all;
}

.selection-indicator {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.staff-item.selected .selection-indicator {
  background: #1AAD19;
  border-color: #1AAD19;
  transform: scale(1.1);
}

.indicator-icon {
  font-size: 24rpx;
  color: white;
  font-weight: bold;
}

/* 无结果状态 */
.no-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  text-align: center;
}

.no-data-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.no-result-text {
  font-size: 28rpx;
  color: #999;
}
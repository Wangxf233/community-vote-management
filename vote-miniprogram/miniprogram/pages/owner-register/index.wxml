<view class="register-container">
  <view class="header">
    <text class="title">户主注册</text>
    <text class="subtitle">请填写真实信息以便审核</text>
  </view>

  <view class="form-container">
    <view class="form-item">
      <view class="label">
        <text class="required">*</text>
        <text>姓名</text>
      </view>
      <input class="input" placeholder="请输入真实姓名" value="{{formData.name}}" bindinput="onNameInput" />
    </view>

    <view class="form-item">
      <view class="label">
        <text class="required">*</text>
        <text>手机号</text>
      </view>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{formData.phone}}" bindinput="onPhoneInput" bindblur="onPhoneBlur" />
    </view>

    <view class="form-item">
      <view class="label">
        <text class="required">*</text>
        <text>小区名称</text>
      </view>
      <picker mode="region" bindchange="onRegionChange" value="{{region}}">
        <view class="picker">
          <text wx:if="{{region[0]}}">{{region[0]}}{{region[1] && region[1] !== '市辖区' ? ' ' + region[1] : ''}} {{region[2]}}</text>
          <text wx:else class="placeholder">请选择省市区</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <input 
        class="input" 
        placeholder="请输入小区名称" 
        value="{{formData.communityName}}" 
        bindinput="onCommunityInput" 
        bindfocus="onCommunityFocus"
        bindblur="onCommunityInputBlur" 
      />
      <!-- 小区列表下拉框 -->
      <view class="community-list" wx:if="{{showCommunityList && communityList.length > 0}}">
        <scroll-view scroll-y class="community-scroll">
          <view 
            class="community-item" 
            wx:for="{{communityList}}" 
            wx:key="name"
            data-name="{{item.name}}"
            bindtap="onSelectCommunity"
          >
            <text class="community-name">{{item.name}}</text>
            <text class="community-address" wx:if="{{item.address}}">{{item.address}}</text>
          </view>
        </scroll-view>
      </view>
      <view class="community-list-empty" wx:if="{{showCommunityList && communityList.length === 0}}">
        <text>该区域暂无已注册小区</text>
      </view>
    </view>

    <view class="form-item" wx:if="{{communityNotFound}}">
      <view class="error-tip">
        <text class="error-text">您的小区还未开通服务</text>
      </view>
    </view>

    <view class="form-item" wx:if="{{!communityNotFound && formData.communityName}}">
      <view class="label">
        <text class="required">*</text>
        <text>类型</text>
      </view>
      <radio-group bindchange="onPropertyTypeChange">
        <label class="radio-label">
          <radio value="house" checked="{{formData.propertyType === 'house'}}" />
          <text>房屋</text>
        </label>
        <label class="radio-label" style="margin-left: 30px;">
          <radio value="shop" checked="{{formData.propertyType === 'shop'}}" />
          <text>商铺</text>
        </label>
      </radio-group>
    </view>

    <view class="form-item">
      <view class="label">
        <text class="required">*</text>
        <text>楼栋</text>
      </view>
      <picker mode="selector" range="{{buildings}}" range-key="name" bindchange="onBuildingChange" disabled="{{communityNotFound || buildings.length === 0}}">
        <view class="picker {{communityNotFound || buildings.length === 0 ? 'disabled' : ''}}">
          <text wx:if="{{formData.building}}">{{formData.building}}</text>
          <text wx:else class="placeholder">请选择楼栋</text>
        </view>
      </picker>
    </view>

    <view class="form-item" wx:if="{{units.length > 0}}">
      <view class="label">
        <text class="required">*</text>
        <text>单元</text>
      </view>
      <picker mode="selector" range="{{units}}" range-key="name" bindchange="onUnitChange" disabled="{{communityNotFound}}">
        <view class="picker {{communityNotFound ? 'disabled' : ''}}">
          <text wx:if="{{formData.unit}}">{{formData.unit}}</text>
          <text wx:else class="placeholder">请选择单元</text>
        </view>
      </picker>
    </view>

    <view class="form-item" wx:if="{{rooms.length > 0}}">
      <view class="label">
        <text class="required">*</text>
        <text>{{formData.propertyType === 'shop' ? '门牌号' : '房号'}}</text>
      </view>
      <picker mode="selector" range="{{rooms}}" bindchange="onRoomChange" disabled="{{communityNotFound}}">
        <view class="picker {{communityNotFound ? 'disabled' : ''}}">
          <text wx:if="{{formData.room}}">{{formData.room}}</text>
          <text wx:else class="placeholder">请选择{{formData.propertyType === 'shop' ? '门牌号' : '房号'}}</text>
        </view>
      </picker>
    </view>

    <!-- 添加房产按钮 -->
    <view class="form-item" wx:if="{{!communityNotFound && formData.communityName}}">
      <button class="add-property-btn" bindtap="addProperty">
        <text class="add-icon">+</text> 添加房产
      </button>
    </view>

    <!-- 已添加的房产列表 -->
    <view class="properties-list" wx:if="{{properties.length > 0}}">
      <view class="list-header">
        <text class="list-title">已添加房产（{{properties.length}}套）</text>
      </view>
      <view class="property-item" wx:for="{{properties}}" wx:key="index">
        <view class="property-info">
          <text class="property-type-badge">{{item.propertyType === 'house' ? '房' : '铺'}}</text>
          <text class="property-address">{{item.building}}栋 {{item.unit}}单元 {{item.room}}室</text>
        </view>
        <view class="property-actions">
          <text class="delete-btn" bindtap="deleteProperty" data-index="{{index}}">删除</text>
        </view>
      </view>
    </view>

    <view class="tips">
      <text class="tip-icon">ℹ️</text>
      <text class="tip-text">提交后需要管理员审核，审核通常在24小时内完成</text>
    </view>

    <button class="submit-btn" bindtap="handleSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交审核'}}
    </button>
  </view>
</view>

.my-page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 审核状态提示 */
.status-tip {
  margin: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.status-tip.pending {
  background: #fff3e0;
  border-left: 4rpx solid #ff9800;
}

.status-tip.rejected {
  background: #ffebee;
  border-left: 4rpx solid #f44336;
}

.status-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.status-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
}

/* 区块样式 */
.section {
  background: white;
  margin: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 菜单列表 */
.menu-list {
  background: white;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background: white;
}

.menu-item:active {
  background-color: #f8f9fa;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center; /* 确保左侧内容垂直居中 */
  flex: 1;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center; /* 图片本身垂直居中 */
  justify-content: center;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center; /* 箭头图片垂直居中 */
  justify-content: center;
}

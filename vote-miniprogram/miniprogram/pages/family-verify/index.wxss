.family-verify-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  padding-bottom: 40rpx;
}

.progress-steps {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.step-item.active .step-num {
  background: linear-gradient(135deg, #f093fb, #f5576c);
  color: #fff;
}

.step-text {
  font-size: 22rpx;
  color: #999;
}

.step-item.active .step-text {
  color: #333;
  font-weight: bold;
}

.step-line {
  flex: 1;
  height: 4rpx;
  background: #e0e0e0;
  margin: 0 8rpx;
  margin-bottom: 32rpx;
}

.step-line.active {
  background: linear-gradient(to right, #f093fb, #f5576c);
}

.step-content {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.title-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.label {
  font-size: 28rpx;
  color: #333;
  width: 160rpx;
  flex-shrink: 0;
}

.label.required::before {
  content: "*";
  color: #f5576c;
  margin-right: 4rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.input-value {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

.phone-auth-btn {
  flex: 1;
  height: 64rpx;
  background: linear-gradient(135deg, #f093fb, #f5576c);
  color: #fff;
  border: none;
  border-radius: 32rpx;
  font-size: 26rpx;
  line-height: 64rpx;
  padding: 0;
  margin: 0;
}

.picker-display {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.info-card {
  background: linear-gradient(135deg, #f093fb15, #f5576c15);
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 24rpx 0;
}

.card-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.card-value {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.6;
}

.tips-box {
  background: #fffbf0;
  border-left: 4rpx solid #ffa940;
  padding: 24rpx;
  margin-top: 24rpx;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  color: #fa8c16;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.tips-item {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.primary-btn {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #f093fb, #f5576c);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.primary-btn[disabled] {
  background: #e0e0e0;
  color: #999;
}

.secondary-btn {
  flex: 1;
  height: 88rpx;
  background: #fff;
  color: #f5576c;
  border: 2rpx solid #f5576c;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.status-display {
  text-align: center;
}

.status-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.status-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.status-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.application-info {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 48rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #666;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.timeline {
  padding: 0 48rpx;
  margin-bottom: 48rpx;
}

.timeline-item {
  position: relative;
  padding-left: 48rpx;
  padding-bottom: 40rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 32rpx;
  bottom: 0;
  width: 2rpx;
  background: #e0e0e0;
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #e0e0e0;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #e0e0e0;
}

.timeline-item.completed .timeline-dot {
  background: #52c41a;
  box-shadow: 0 0 0 2rpx #52c41a;
}

.timeline-content {
  text-align: left;
}

.timeline-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.timeline-time {
  display: block;
  font-size: 24rpx;
  color: #999;
}

<view class="family-verify-container">
  <!-- 进度指示 -->
  <view class="progress-steps">
    <view class="step-item {{step >= 1 ? 'active' : ''}}">
      <view class="step-num">1</view>
      <text class="step-text">填写信息</text>
    </view>
    <view class="step-line {{step >= 2 ? 'active' : ''}}"></view>
    <view class="step-item {{step >= 2 ? 'active' : ''}}">
      <view class="step-num">2</view>
      <text class="step-text">等待户主同意</text>
    </view>
    <view class="step-line {{step >= 3 ? 'active' : ''}}"></view>
    <view class="step-item {{step >= 3 ? 'active' : ''}}">
      <view class="step-num">3</view>
      <text class="step-text">管理员审核</text>
    </view>
  </view>

  <!-- 步骤1: 填写家属信息 -->
  <view wx:if="{{step === 1}}" class="step-content">
    <view class="section-title">
      <text class="title-icon">👨‍👩‍👧‍👦</text>
      <text class="title-text">家属信息填写</text>
    </view>

    <view class="form-group">
      <view class="form-item">
        <text class="label required">手机号</text>
        <button wx:if="{{!phone}}" class="phone-auth-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
          点击授权
        </button>
        <view wx:else class="input-value">{{phone}}</view>
      </view>

      <view class="form-item">
        <text class="label required">您的姓名</text>
        <input class="input" placeholder="请输入真实姓名" value="{{memberName}}" bindinput="onMemberNameInput" />
      </view>

      <view class="form-item">
        <text class="label required">与户主关系</text>
        <picker mode="selector" range="{{relationships}}" value="{{relationshipIndex}}" bindchange="onRelationshipChange">
          <view class="picker-display">{{relationships[relationshipIndex] || '请选择关系'}}</view>
        </picker>
      </view>

      <view class="info-card">
        <text class="card-label">申请绑定的房屋:</text>
        <text class="card-value">{{communityName}}</text>
        <text class="card-value">{{building}}栋{{unit}}单元{{room}}室</text>
      </view>

      <view class="tips-box">
        <text class="tips-title">📢 温馨提示</text>
        <text class="tips-item">• 家属认证需要户主同意后才能提交管理员审核</text>
        <text class="tips-item">• 请填写真实信息,便于户主识别</text>
        <text class="tips-item">• 家属仅可查看信息,不能参与投票</text>
      </view>
    </view>

    <view class="action-buttons">
      <button class="primary-btn" bindtap="submitApplication" disabled="{{!canSubmit || submitting}}">
        {{submitting ? '提交中...' : '提交申请'}}
      </button>
    </view>
  </view>

  <!-- 步骤2: 等待户主同意 -->
  <view wx:if="{{step === 2}}" class="step-content">
    <view class="status-display">
      <image src="cloud://cloud1-6ghienoi526fff51.636c-cloud1-6ghienoi526fff51-1325504194/images/waiting.png" class="status-icon" mode="aspectFit" />
      <text class="status-title">等待户主同意</text>
      <text class="status-desc">您的家属申请已发送给户主,请耐心等待户主审核</text>

      <view class="application-info">
        <view class="info-row">
          <text class="info-label">申请人</text>
          <text class="info-value">{{memberName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">关系</text>
          <text class="info-value">{{relationships[relationshipIndex]}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">申请房屋</text>
          <text class="info-value">{{building}}栋{{unit}}单元{{room}}室</text>
        </view>
        <view class="info-row">
          <text class="info-label">申请时间</text>
          <text class="info-value">{{applyTime}}</text>
        </view>
      </view>

      <view class="action-buttons">
        <button class="secondary-btn" bindtap="goHome">返回首页</button>
      </view>
    </view>
  </view>

  <!-- 步骤3: 户主已同意,等待管理员审核 -->
  <view wx:if="{{step === 3}}" class="step-content">
    <view class="status-display">
      <image src="cloud://cloud1-6ghienoi526fff51.636c-cloud1-6ghienoi526fff51-1325504194/images/review.png" class="status-icon" mode="aspectFit" />
      <text class="status-title">管理员审核中</text>
      <text class="status-desc">户主已同意您的申请,管理员将在1-3个工作日内完成审核</text>

      <view class="timeline">
        <view class="timeline-item completed">
          <view class="timeline-dot"></view>
          <view class="timeline-content">
            <text class="timeline-title">提交申请</text>
            <text class="timeline-time">{{applyTime}}</text>
          </view>
        </view>
        <view class="timeline-item completed">
          <view class="timeline-dot"></view>
          <view class="timeline-content">
            <text class="timeline-title">户主同意</text>
            <text class="timeline-time">{{approveTime}}</text>
          </view>
        </view>
        <view class="timeline-item">
          <view class="timeline-dot"></view>
          <view class="timeline-content">
            <text class="timeline-title">管理员审核</text>
            <text class="timeline-time">审核中...</text>
          </view>
        </view>
      </view>

      <view class="action-buttons">
        <button class="primary-btn" bindtap="goHome">返回首页</button>
      </view>
    </view>
  </view>
</view>
